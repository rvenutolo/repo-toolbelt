#!/usr/bin/env bash

# @description Git pre-commit hook: checks the working tree's formatting with
#              the check lints of the formatters this repo dogfoods
#              (.ci/dogfood-formatters.bash), run by the runner built from the
#              working tree inside the devShell, and aborts the commit on a
#              finding. A check, never a rewrite: ./.ci/fmt rewrites. Started
#              outside the devShell, as git starts it for a commit made from
#              the host, it re-runs itself through .ci/in-devshell. That re-run
#              needs what .ci/in-devshell needs on the host: bash 4.4+, git,
#              GNU coreutils (readlink, mktemp, rm) and nix. On macOS: brew
#              install bash coreutils, with the coreutils gnubin directory
#              first on PATH.
# @noargs
# @exitcode 0 the check passed.
# @exitcode 1 the check found a file to format, or could not run.

set -Eeuo pipefail
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

# Git runs hooks with the caller's environment, and an interactive shell leaves
# IN_DEVSHELL unset and the host PATH in place: a tool the flake lacks would
# resolve from the host. Re-run through in-devshell, which sets IN_DEVSHELL and
# so stops the recursion. .ci/in-devshell admits only its allowlist, so the
# index git is committing, which git names in GIT_INDEX_FILE, is handed to the
# re-run here: under `git commit --all` or `git commit <path>` it is a
# temporary index, not .git/index, and without it the runner's
# unstaged-changes warning compares the working tree with the wrong index.
if [[ -z "${IN_DEVSHELL:-}" ]]; then
  SELF_PATH="$(readlink --canonicalize -- "${BASH_SOURCE[0]}")"
  SELF_DIR="${SELF_PATH%/*}"
  if [[ -n "${GIT_INDEX_FILE:-}" ]]; then
    exec "${SELF_DIR}/../.ci/in-devshell" env "GIT_INDEX_FILE=${GIT_INDEX_FILE}" "${SELF_PATH}" "$@"
  fi
  exec "${SELF_DIR}/../.ci/in-devshell" "${SELF_PATH}" "$@"
fi

# shellcheck source=.ci/dogfood-formatters.bash
source "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/../.ci/dogfood-formatters.bash"

# @description Run the formatter checks; abort the commit on failure.
# @noargs
function main() {
  local repo_dir
  repo_dir="$(git rev-parse --show-toplevel)"
  printf 'pre-commit: checking formatting\n' >&2
  local status=0
  "${repo_dir}/.ci/run-built-toolbelt" run --hook pre-commit "${DOGFOOD_FORMATTER_CHECKS[@]}" || status=$?
  # Exit 1 is a finding, which .ci/fmt can fix; anything else (exit 2, a
  # layout that did not build or a runner error) means the check never ran.
  case "${status}" in
    0) ;; # coverage-exempt: kcov scores this line; it never executes as bash
    1)
      printf 'pre-commit: formatting check failed; run ./.ci/fmt and stage the result\n' >&2
      exit 1
      ;;
    *)
      printf 'pre-commit: the formatting check could not run; see the error above\n' >&2
      exit 1
      ;;
  esac
  printf 'pre-commit: formatting check passed\n' >&2
}

main "$@"
