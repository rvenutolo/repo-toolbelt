#!/usr/bin/env bats

bats_require_minimum_version 1.5.0

# Fixture text. Nothing in a fixture is ever compiled or run: the formatter
# only parses and prints it.
readonly GO_MOD=$'module example.com/fixture\n\ngo 1.22\n'
# gofumpt's own rule: an octal literal takes the 0o prefix from go1.13 on.
readonly UNFORMATTED_GO=$'package x\n\nfunc f() {\n\t_ = 0755\n}\n'
readonly FORMATTED_GO=$'package x\n\nfunc f() {\n\t_ = 0o755\n}\n'
# goimports' grouping: stdlib, then third-party, then the module's own
# packages. "strings" is unused and fmt is used but not imported; neither is
# goimports' business with -format-only.
readonly UNGROUPED_GO=$'package x\n\nimport (\n\t"example.com/fixture/sub"\n\t"example.org/other/pkg"\n\t"os"\n\t"strings"\n)\n\nfunc f() {\n\t_ = os.Exit\n\t_ = pkg.X\n\t_ = sub.Y\n\t_ = fmt.Println\n}\n'
readonly GROUPED_GO=$'package x\n\nimport (\n\t"os"\n\t"strings"\n\n\t"example.org/other/pkg"\n\n\t"example.com/fixture/sub"\n)\n\nfunc f() {\n\t_ = os.Exit\n\t_ = pkg.X\n\t_ = sub.Y\n\t_ = fmt.Println\n}\n'
readonly UNPARSABLE=$'package x\nfunc {\n'
readonly PARSE_MESSAGE="2:6: expected 'IDENT', found '{'"
readonly MARKER='// Code generated by stub. DO NOT EDIT.'

function setup() {
  load test_helper/common
  FORMATTER_PATH="${REPO_DIR}/formatters/go/go"
  WORK_DIR="${BATS_TEST_TMPDIR}/work"
  mkdir --parents "${WORK_DIR}"
  cd "${WORK_DIR}" || return 1
  # Temp files belong under TMPDIR, never in the checkout; a directory of the
  # test's own shows whether the formatter cleans up after itself.
  export TMPDIR="${BATS_TEST_TMPDIR}/tmp"
  mkdir --parents "${TMPDIR}"
  set_mode check
  # The runner always hands a formatter a section file; `null` is what it
  # writes when the config file has no section.
  write_section <<< 'null'
  write_list
  write_file go.mod "${GO_MOD}"
  REAL_GOFUMPT="$(command -v gofumpt)"
  REAL_GOIMPORTS="$(command -v goimports)"
  export REAL_GOFUMPT REAL_GOIMPORTS
  export TOOL_CALLS="${BATS_TEST_TMPDIR}/tool-calls"
}

# A test that makes a file unreadable restores it here, so bats can delete the
# test's temp dir.
function teardown() {
  if [[ -n "${LOCKED_FILE:-}" ]]; then
    chmod u+rw -- "${LOCKED_FILE}"
  fi
}

# @description Set the formatter's mode for the runs that follow, as
#              TOOLBELT_MODE.
# @arg $1 mode check or write, or any other value to test its rejection
function set_mode() {
  local -r mode="$1"
  export TOOLBELT_MODE="${mode}"
}

# @description Write the given paths, each terminated by NUL, to a file
#              outside the work dir, and export its path as TOOLBELT_FILES, as
#              the runner does.
# @arg $@ paths the repo-relative paths to list
function write_list() {
  local -r list_file="${BATS_TEST_TMPDIR}/files"
  : > "${list_file}"
  local path
  for path in "$@"; do
    printf '%s\0' "${path}" >> "${list_file}"
  done
  export TOOLBELT_FILES="${list_file}"
}

# @description Write text to a file in the work dir, exactly, with no trailing
#              newline added.
# @arg $1 path the file's path relative to the work dir
# @arg $2 text the content
function write_file() {
  local -r path="$1"
  local -r text="$2"
  printf '%s' "${text}" > "${WORK_DIR}/${path}"
}

# @description Assert a file in the work dir holds exactly the given text.
# @arg $1 path the file's path relative to the work dir
# @arg $2 text the expected content
function assert_content() {
  local -r path="$1"
  local -r text="$2"
  local actual
  # The x keeps any trailing newlines through the command substitution.
  actual="$(cat -- "${WORK_DIR}/${path}" && printf 'x')"
  assert_equal "${actual%x}" "${text}"
}

# @description Print a checksum of every file in the work dir, with its name,
#              so a run that writes, adds or removes a file changes the output.
# @noargs
function snapshot() {
  find "${WORK_DIR}" -type f -printf '%P\0' | sort --zero-terminated \
    | (cd "${WORK_DIR}" && xargs --null --no-run-if-empty --max-args=100 sha256sum --)
}

# @description Put stub gofumpt and goimports first on PATH. Each records one
#              line per call in TOOL_CALLS, `<tool> <count>`, the count being
#              gofumpt's path arguments after `--`, or 0 for goimports, then
#              runs the real tool.
# @noargs
function stub_recording_tools() {
  mkdir --parents "${BATS_TEST_TMPDIR}/bin"
  cat > "${BATS_TEST_TMPDIR}/bin/gofumpt" << 'EOF'
#!/usr/bin/env bash
paths=0
after=0
for arg in "$@"; do
  if ((after == 1)); then
    paths=$((paths + 1))
  elif [[ "${arg}" == '--' ]]; then
    after=1
  fi
done
printf 'gofumpt %s\n' "${paths}" >> "${TOOL_CALLS}"
exec "${REAL_GOFUMPT}" "$@"
EOF
  cat > "${BATS_TEST_TMPDIR}/bin/goimports" << 'EOF'
#!/usr/bin/env bash
printf 'goimports 0\n' >> "${TOOL_CALLS}"
exec "${REAL_GOIMPORTS}" "$@"
EOF
  chmod +x "${BATS_TEST_TMPDIR}/bin/gofumpt" "${BATS_TEST_TMPDIR}/bin/goimports"
  PATH="${BATS_TEST_TMPDIR}/bin:${PATH}"
}

# @description Put a stub tool first on PATH whose body is the given text.
# @arg $1 tool gofumpt or goimports
# @arg $2 body the stub's bash body, after the shebang
function stub_tool() {
  local -r tool="$1"
  local -r body="$2"
  mkdir --parents "${BATS_TEST_TMPDIR}/bin"
  printf '#!/usr/bin/env bash\n%s\n' "${body}" > "${BATS_TEST_TMPDIR}/bin/${tool}"
  chmod +x "${BATS_TEST_TMPDIR}/bin/${tool}"
  PATH="${BATS_TEST_TMPDIR}/bin:${PATH}"
}

# @description Print PATH without the directory that holds the given tool.
#              The devShell puts each package's bin/ on PATH on its own, so
#              dropping a tool's directory drops that tool alone.
# @arg $1 tool_path the tool's resolved path
# @stdout the reduced PATH
function path_without() {
  local -r tool_path="$1"
  local tool_dir
  tool_dir="$(dirname -- "${tool_path}")"
  local kept='' dir
  local -a dirs
  IFS=':' read -r -a dirs <<< "${PATH}"
  for dir in "${dirs[@]}"; do
    if [[ "${dir}" != "${tool_dir}" ]]; then
      kept="${kept:+${kept}:}${dir}"
    fi
  done
  printf '%s\n' "${kept}"
}

# @description Assert TMPDIR holds nothing after a run.
# @noargs
function assert_tmpdir_empty() {
  run find "${TMPDIR}" -mindepth 1
  assert_output ''
}

@test '--help prints the usage and exits 0' {
  run --separate-stderr "${FORMATTER_PATH}" --help
  assert_success
  assert_output 'usage: go [--help]'
  assert_stderr ''
}

@test 'an unexpected argument is a setup failure' {
  run --separate-stderr "${FORMATTER_PATH}" --bogus
  assert_failure 2
  assert_output ''
  assert_stderr --partial "unexpected argument '--bogus'"
}

@test 'more than one argument is a setup failure' {
  run --separate-stderr "${FORMATTER_PATH}" --help --help
  assert_failure 2
  assert_stderr --partial 'expected at most one argument, got 2'
}

@test 'check mode reports a gofumpt change and an import-grouping change and writes nothing' {
  write_file a.go "${UNFORMATTED_GO}"
  write_file b.go "${UNGROUPED_GO}"
  write_list a.go b.go
  local before
  before="$(snapshot)"
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 1
  assert_output "$(printf '%s\n' 'a.go: not formatted' 'b.go: not formatted' '2 file(s)')"
  assert_stderr ''
  assert_equal "$(snapshot)" "${before}"
  assert_tmpdir_empty
}

@test 'check mode passes formatted files' {
  write_file a.go "${FORMATTED_GO}"
  write_file b.go "${GROUPED_GO}"
  write_list a.go b.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_success
  assert_output ''
  assert_stderr ''
  assert_tmpdir_empty
}

@test 'check mode reports only the files that would change, in list order, with the count' {
  write_file z.go "${UNFORMATTED_GO}"
  write_file m.go "${FORMATTED_GO}"
  write_file a.go "${UNGROUPED_GO}"
  write_list z.go m.go a.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 1
  assert_output "$(printf '%s\n' 'z.go: not formatted' 'a.go: not formatted' '2 file(s)')"
}

@test 'imports group stdlib, third-party and module-local; none is added and none removed' {
  set_mode write
  write_file a.go "${UNGROUPED_GO}"
  write_list a.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_success
  assert_output ''
  assert_stderr ''
  assert_content a.go "${GROUPED_GO}"
}

@test 'a file gofumpt cannot parse is a finding, in check mode' {
  write_file bad.go "${UNPARSABLE}"
  write_file ugly.go "${UNFORMATTED_GO}"
  write_list bad.go ugly.go
  local before
  before="$(snapshot)"
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 1
  assert_output "$(printf '%s\n' "bad.go: cannot be parsed: ${PARSE_MESSAGE}" 'ugly.go: not formatted' '2 file(s)')"
  assert_stderr ''
  assert_equal "$(snapshot)" "${before}"
  assert_tmpdir_empty
}

@test 'several parse errors in one file make one finding on one line' {
  write_file bad.go $'package x\nfunc {\nvar = \nfunc ) {\n'
  write_list bad.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 1
  assert_output "$(printf '%s\n' \
    "bad.go: cannot be parsed: 2:6: expected 'IDENT', found '{'; 3:1: expected '(', found 'var'; 4:10: expected '}', found 'EOF'" \
    '1 file(s)')"
  assert_stderr ''
}

@test 'a generated marker before the package clause skips the file' {
  write_file gen.go "${MARKER}"$'\n\n'"${UNFORMATTED_GO}"
  write_file built.go $'//go:build linux\n\n// A note on the file.\n'"${MARKER}"$'\n\n'"${UNFORMATTED_GO}"
  write_file ugly.go "${UNFORMATTED_GO}"
  write_list gen.go built.go ugly.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 1
  assert_output "$(printf '%s\n' 'ugly.go: not formatted' '1 file(s)')"
  assert_stderr ''
}

@test 'write mode leaves a generated file untouched' {
  set_mode write
  write_file gen.go "${MARKER}"$'\n\n'"${UNFORMATTED_GO}"
  write_list gen.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_success
  assert_content gen.go "${MARKER}"$'\n\n'"${UNFORMATTED_GO}"
}

@test 'a generated marker after the package clause does not skip the file' {
  write_file late.go $'package x\n\n'"${MARKER}"$'\n\nfunc f() {\n\t_ = 0755\n}\n'
  write_list late.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 1
  assert_output "$(printf '%s\n' 'late.go: not formatted' '1 file(s)')"
}

@test 'a near-miss marker without DO NOT EDIT. does not skip the file' {
  write_file a.go $'// Code generated by stub.\n\n'"${UNFORMATTED_GO}"
  write_file b.go $'// Code generated by stub. DO NOT EDIT\n\n'"${UNFORMATTED_GO}"
  write_file c.go $'// code generated by stub. DO NOT EDIT.\n\n'"${UNFORMATTED_GO}"
  write_list a.go b.go c.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 1
  assert_output "$(printf '%s\n' 'a.go: not formatted' 'b.go: not formatted' 'c.go: not formatted' '3 file(s)')"
}

@test 'a file with no package clause is not generated, and is a parse finding' {
  write_file a.go $'// Only a comment.\n'
  write_list a.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 1
  assert_output "$(printf '%s\n' "a.go: cannot be parsed: 1:20: expected 'package', found 'EOF'" '1 file(s)')"
  assert_stderr ''
}

@test 'a list of only generated files runs no tool and needs no go.mod' {
  stub_recording_tools
  rm -- "${WORK_DIR}/go.mod"
  write_file gen.go "${MARKER}"$'\n\n'"${UNFORMATTED_GO}"
  write_list gen.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_success
  assert_output ''
  assert_stderr ''
  refute [ -e "${TOOL_CALLS}" ]
}

@test 'an empty list passes in check mode without running a tool or needing a go.mod' {
  stub_recording_tools
  rm -- "${WORK_DIR}/go.mod"
  run --separate-stderr "${FORMATTER_PATH}"
  assert_success
  assert_output ''
  assert_stderr ''
  refute [ -e "${TOOL_CALLS}" ]
}

@test 'an empty list does nothing in write mode without running a tool' {
  set_mode write
  stub_recording_tools
  run --separate-stderr "${FORMATTER_PATH}"
  assert_success
  assert_output ''
  assert_stderr ''
  refute [ -e "${TOOL_CALLS}" ]
}

@test 'a file with no trailing newline is not formatted, and write mode adds one' {
  write_file a.go 'package x'
  write_list a.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 1
  assert_output "$(printf '%s\n' 'a.go: not formatted' '1 file(s)')"
  set_mode write
  run --separate-stderr "${FORMATTER_PATH}"
  assert_success
  assert_content a.go $'package x\n'
}

@test 'a file ending in several blank lines is not formatted, and write mode trims them' {
  write_file a.go $'package x\n\n\n\n'
  write_file ok.go $'package x\n'
  write_list a.go ok.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 1
  assert_output "$(printf '%s\n' 'a.go: not formatted' '1 file(s)')"
  set_mode write
  run --separate-stderr "${FORMATTER_PATH}"
  assert_success
  assert_content a.go $'package x\n'
  assert_content ok.go $'package x\n'
}

@test 'paths with a space, a newline or a leading dash, or a bare dash, each reach gofumpt as one path' {
  stub_recording_tools
  write_file 'sp ace.go' "${UNFORMATTED_GO}"
  write_file $'new\nline.go' "${UNFORMATTED_GO}"
  write_file '-lead.go' "${UNFORMATTED_GO}"
  write_file '-' "${UNFORMATTED_GO}"
  write_file '--' "${FORMATTED_GO}"
  write_list 'sp ace.go' $'new\nline.go' '-lead.go' '-' '--'
  run --separate-stderr "${FORMATTER_PATH}" < '/dev/null'
  assert_failure 1
  assert_output "$(printf '%s\n' 'sp ace.go: not formatted' 'new\nline.go: not formatted' \
    '-lead.go: not formatted' '-: not formatted' '4 file(s)')"
  assert_stderr ''
  run cat -- "${TOOL_CALLS}"
  assert_output "$(printf 'gofumpt 1\ngoimports 0\n%.0s' 1 2 3 4 5)"
}

@test 'write mode rewrites paths with a space, a newline or a leading dash, and a bare dash' {
  set_mode write
  write_file 'sp ace.go' "${UNFORMATTED_GO}"
  write_file $'new\nline.go' "${UNFORMATTED_GO}"
  write_file '-lead.go' "${UNFORMATTED_GO}"
  write_file '-' "${UNFORMATTED_GO}"
  write_list 'sp ace.go' $'new\nline.go' '-lead.go' '-'
  run --separate-stderr "${FORMATTER_PATH}" < '/dev/null'
  assert_success
  assert_output ''
  assert_stderr ''
  assert_content 'sp ace.go' "${FORMATTED_GO}"
  assert_content $'new\nline.go' "${FORMATTED_GO}"
  assert_content '-lead.go' "${FORMATTED_GO}"
  assert_content '-' "${FORMATTED_GO}"
}

@test 'a parse error in a path with a newline, a leading dash or a bare dash is a finding for that path' {
  write_file $'bad\nnl.go' "${UNPARSABLE}"
  write_file '-bad.go' "${UNPARSABLE}"
  write_file '-' "${UNPARSABLE}"
  write_list $'bad\nnl.go' '-bad.go' '-'
  run --separate-stderr "${FORMATTER_PATH}" < '/dev/null'
  assert_failure 1
  assert_output "$(printf '%s\n' "bad\\nnl.go: cannot be parsed: ${PARSE_MESSAGE}" \
    "-bad.go: cannot be parsed: ${PARSE_MESSAGE}" "-: cannot be parsed: ${PARSE_MESSAGE}" '3 file(s)')"
  assert_stderr ''
}

@test 'a generated marker is found in a path with a newline or a leading dash' {
  write_file $'gen\nnl.go' "${MARKER}"$'\n\n'"${UNFORMATTED_GO}"
  write_file '-gen.go' "${MARKER}"$'\n\n'"${UNFORMATTED_GO}"
  write_list $'gen\nnl.go' '-gen.go'
  run --separate-stderr "${FORMATTER_PATH}" < '/dev/null'
  assert_success
  assert_output ''
}

@test 'gofumpt takes the language version from the nearest go.mod' {
  mkdir --parents "${WORK_DIR}/old"
  write_file old/go.mod $'module example.com/old\n\ngo 1.12\n'
  write_file old/o.go "${UNFORMATTED_GO}"
  write_file n.go "${UNFORMATTED_GO}"
  write_list old/o.go n.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 1
  assert_output "$(printf '%s\n' 'n.go: not formatted' '1 file(s)')"
}

@test 'a nested module groups imports by the root module path' {
  set_mode write
  mkdir --parents "${WORK_DIR}/nested"
  write_file nested/go.mod $'module example.com/nested\n\ngo 1.22\n'
  write_file nested/a.go "${UNGROUPED_GO}"
  write_list nested/a.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_success
  assert_content nested/a.go "${GROUPED_GO}"
}

@test 'a quoted module path and a comment on the module line are read' {
  set_mode write
  write_file go.mod $'// The fixture module.\nmodule "example.com/fixture" // the root\n\ngo 1.22\n'
  write_file a.go "${UNGROUPED_GO}"
  write_list a.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_success
  assert_content a.go "${GROUPED_GO}"
}

@test 'no go.mod at the repo root is a setup failure naming it' {
  rm -- "${WORK_DIR}/go.mod"
  write_file a.go "${FORMATTED_GO}"
  write_list a.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 2
  assert_output ''
  assert_stderr --partial 'go: cannot read go.mod'
}

@test 'a go.mod with no module line is a setup failure naming it' {
  write_file go.mod $'go 1.22\n\n// module example.com/fixture\n'
  write_file a.go "${FORMATTED_GO}"
  write_list a.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 2
  assert_output ''
  assert_stderr --partial 'go: go.mod has no module line'
}

@test 'write mode rewrites each unformatted file and exits 0' {
  set_mode write
  write_file a.go "${UNFORMATTED_GO}"
  write_file b.go "${UNGROUPED_GO}"
  write_file ok.go "${FORMATTED_GO}"
  write_list a.go b.go ok.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_success
  assert_output ''
  assert_stderr ''
  assert_content a.go "${FORMATTED_GO}"
  assert_content b.go "${GROUPED_GO}"
  assert_content ok.go "${FORMATTED_GO}"
  # Nothing but the listed files and go.mod is left in the checkout, and
  # TMPDIR is clean.
  run bash -c 'find "$1" -mindepth 1 -printf "%P\n" | LC_ALL=C sort' _ "${WORK_DIR}"
  assert_output "$(printf '%s\n' a.go b.go go.mod ok.go)"
  assert_tmpdir_empty
}

@test 'write mode leaves a formatted file unwritten' {
  set_mode write
  write_file ok.go "${FORMATTED_GO}"
  touch --date='2001-01-01 00:00:00' -- "${WORK_DIR}/ok.go"
  write_list ok.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_success
  assert_equal "$(stat --format='%Y' -- "${WORK_DIR}/ok.go")" "$(date --date='2001-01-01 00:00:00' '+%s')"
}

@test 'write mode rewrites in place, keeping mode bits, inode and hard links' {
  set_mode write
  write_file a.go "${UNFORMATTED_GO}"
  chmod 0640 -- "${WORK_DIR}/a.go"
  ln -- "${WORK_DIR}/a.go" "${BATS_TEST_TMPDIR}/hard-link"
  local inode_before
  inode_before="$(stat --format='%i' -- "${WORK_DIR}/a.go")"
  write_list a.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_success
  assert_content a.go "${FORMATTED_GO}"
  assert_equal "$(stat --format='%a' -- "${WORK_DIR}/a.go")" '640'
  assert_equal "$(stat --format='%i' -- "${WORK_DIR}/a.go")" "${inode_before}"
  assert_equal "$(stat --format='%h' -- "${WORK_DIR}/a.go")" '2'
  run cat -- "${BATS_TEST_TMPDIR}/hard-link"
  assert_output "${FORMATTED_GO%$'\n'}"
}

@test 'write mode reports a file it cannot parse, leaves it untouched and exits 1' {
  set_mode write
  write_file bad.go "${UNPARSABLE}"
  write_file ugly.go "${UNFORMATTED_GO}"
  write_list bad.go ugly.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 1
  assert_output "$(printf '%s\n' "bad.go: cannot be parsed: ${PARSE_MESSAGE}" '1 file(s)')"
  assert_stderr ''
  assert_content bad.go "${UNPARSABLE}"
  assert_content ugly.go "${FORMATTED_GO}"
}

@test 'write mode: a file it cannot write is a setup failure, not a finding' {
  set_mode write
  write_file locked.go "${UNFORMATTED_GO}"
  chmod 0444 -- "${WORK_DIR}/locked.go"
  LOCKED_FILE="${WORK_DIR}/locked.go"
  write_list locked.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 2
  assert_output ''
  assert_stderr --partial 'go: cannot write locked.go'
  assert_content locked.go "${UNFORMATTED_GO}"
}

@test 'a file it cannot read is a setup failure, not a finding' {
  stub_recording_tools
  write_file locked.go "${FORMATTED_GO}"
  chmod 0000 -- "${WORK_DIR}/locked.go"
  LOCKED_FILE="${WORK_DIR}/locked.go"
  write_list locked.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 2
  assert_output ''
  assert_stderr --partial 'go: cannot read locked.go'
  refute [ -e "${TOOL_CALLS}" ]
}

@test 'gofumpt stderr that is not a parse error is a setup failure' {
  stub_tool gofumpt "printf 'gofumpt: something broke\n' >&2; exit 2"
  write_file a.go "${FORMATTED_GO}"
  write_list a.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 2
  assert_output ''
  assert_stderr --partial 'gofumpt failed on a.go: gofumpt: something broke'
}

@test 'a parse error naming a path that is not the file is a setup failure' {
  stub_tool gofumpt "printf 'other.go:2:6: expected IDENT\n' >&2; exit 2"
  write_file a.go "${FORMATTED_GO}"
  write_list a.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 2
  assert_output ''
  assert_stderr --partial 'other.go:2:6:'
}

@test 'stderr naming the file without a position is a setup failure' {
  stub_tool gofumpt "printf 'a.go: open: input/output error\n' >&2; exit 2"
  write_file a.go "${FORMATTED_GO}"
  write_list a.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 2
  assert_output ''
  assert_stderr --partial 'gofumpt failed on a.go: a.go: open: input/output error'
}

@test 'a parse error line followed by other stderr is a setup failure' {
  stub_tool gofumpt "printf 'a.go:2:6: bad\ngofumpt: something broke\n' >&2; exit 2"
  write_file a.go "${FORMATTED_GO}"
  write_list a.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 2
  assert_output ''
  assert_stderr --partial 'gofumpt: something broke'
}

@test 'gofumpt exiting 2 with no stderr is a setup failure' {
  stub_tool gofumpt 'exit 2'
  write_file a.go "${FORMATTED_GO}"
  write_list a.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 2
  assert_output ''
  assert_stderr --partial 'gofumpt failed on a.go'
}

@test 'gofumpt exiting with a status other than 0 or 2 is a setup failure, parse-shaped stderr or not' {
  stub_tool gofumpt "printf 'a.go:2:6: bad\n' >&2; exit 1"
  write_file a.go "${FORMATTED_GO}"
  write_list a.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 2
  assert_output ''
  assert_stderr --partial 'gofumpt exited 1 on a.go'
}

@test 'goimports failing is a setup failure' {
  stub_tool goimports "printf 'goimports: crashed\n' >&2; exit 2"
  write_file a.go "${FORMATTED_GO}"
  write_list a.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 2
  assert_output ''
  assert_stderr --partial 'goimports failed on a.go: goimports: crashed'
}

@test 'write mode: goimports failing leaves the file untouched' {
  set_mode write
  stub_tool goimports "printf 'goimports: crashed\n' >&2; exit 2"
  write_file a.go "${UNFORMATTED_GO}"
  write_list a.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 2
  assert_output ''
  assert_content a.go "${UNFORMATTED_GO}"
}

@test 'goimports is told the root module as its local prefix and to format only' {
  stub_tool goimports "printf '%s\n' \"\$*\" >> \"\${TOOL_CALLS}\"; exec \"\${REAL_GOIMPORTS}\" \"\$@\""
  write_file a.go "${FORMATTED_GO}"
  write_list a.go
  run --separate-stderr "${FORMATTER_PATH}"
  assert_success
  run cat -- "${TOOL_CALLS}"
  assert_output '-format-only -local example.com/fixture'
}

@test 'gofumpt missing from PATH is a setup failure' {
  write_file a.go "${FORMATTED_GO}"
  write_list a.go
  PATH="$(path_without "${REAL_GOFUMPT}")"
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 2
  assert_output ''
  assert_stderr --partial 'gofumpt not found on PATH'
}

@test 'goimports missing from PATH is a setup failure' {
  write_file a.go "${FORMATTED_GO}"
  write_list a.go
  PATH="$(path_without "${REAL_GOIMPORTS}")"
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 2
  assert_output ''
  assert_stderr --partial 'goimports not found on PATH'
}

@test 'an unknown TOOLBELT_MODE is a setup failure' {
  set_mode fix
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 2
  assert_stderr --partial "TOOLBELT_MODE must be 'check' or 'write', got 'fix'"
}

@test 'TOOLBELT_MODE unset is a setup failure' {
  unset TOOLBELT_MODE
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 2
  assert_stderr --partial "TOOLBELT_MODE must be 'check' or 'write', got ''"
}

@test 'TOOLBELT_FILES unset is a setup failure' {
  unset TOOLBELT_FILES
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 2
  assert_stderr --partial 'TOOLBELT_FILES is not set'
}

@test 'an unreadable file list is a setup failure' {
  chmod 0000 -- "${TOOLBELT_FILES}"
  LOCKED_FILE="${TOOLBELT_FILES}"
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 2
  assert_stderr --partial "cannot read the file list ${TOOLBELT_FILES}"
}

@test 'a missing file list is a setup failure' {
  export TOOLBELT_FILES="${BATS_TEST_TMPDIR}/no-such-list"
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 2
  assert_stderr --partial "cannot read the file list ${TOOLBELT_FILES}"
}

@test 'TOOLBELT_SECTION unset is a setup failure' {
  unset TOOLBELT_SECTION
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 2
  assert_stderr --partial 'TOOLBELT_SECTION is not set'
}

@test 'TOOLBELT_SECTION naming no file is a setup failure' {
  export TOOLBELT_SECTION="${BATS_TEST_TMPDIR}/no-such-section"
  run --separate-stderr "${FORMATTER_PATH}"
  assert_failure 2
  assert_stderr --partial "TOOLBELT_SECTION names no file: ${TOOLBELT_SECTION}"
}
