#!/usr/bin/env bash

# @description Fixture for test/self-wrap.bats: a script that follows the
#              self-wrap rule and reports where it ended up. It prints
#              IN_DEVSHELL, PATH and each argument on a line of their own
#              (`IN_DEVSHELL=<value>`, `PATH=<value>`, `ARG=<value>`), then
#              exits with the status given by a leading `--exit=N`, or 0.
#              The status is an argument and not an environment variable
#              because the devShell wipes the environment, so a variable would
#              not survive the re-run.
# @arg $@ any arguments, echoed back unchanged; a leading --exit=N is consumed
# @stdout the IN_DEVSHELL, PATH and ARG lines
# @exitcode * the N of --exit=N, or 0

set -Eeuo pipefail
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

# The same block every gate script carries: see run-all-checks.
if [[ -z "${IN_DEVSHELL:-}" ]]; then
  SELF_PATH="$(readlink --canonicalize -- "${BASH_SOURCE[0]}")"
  SELF_DIR="${SELF_PATH%/*}"
  exec "${SELF_DIR}/../../.ci/in-devshell" "${SELF_PATH}" "$@"
fi

probe_exit=0
if [[ "${1:-}" == --exit=* ]]; then
  probe_exit="${1#--exit=}"
  shift
fi

printf 'IN_DEVSHELL=%s\n' "${IN_DEVSHELL}"
printf 'PATH=%s\n' "${PATH}"
for arg in "$@"; do
  printf 'ARG=%s\n' "${arg}"
done
exit "${probe_exit}"
