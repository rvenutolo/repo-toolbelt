#!/usr/bin/env bats
# bats file_tags=e2e

# The Go formatter in the image: its lint, check-go-formatted, run the way the
# hook files run it, and `fmt go` run with the read-write mount the README
# gives. The image carries gofumpt and goimports but no Go toolchain; the
# `disallowedReferences` in nix/formatter-tools.nix keeps goimports from
# pulling one in. So every test that reaches a tool also shows the formatter
# needs none.
#
# The Go fixtures are written into each test's temp repo, never kept under
# test/e2e/fixtures, so this repo's own check-go-formatted never sees
# deliberately unformatted Go.

bats_require_minimum_version 1.5.0

# Fixture text. Nothing in a fixture is ever compiled or run: the formatter
# only parses and prints it.
readonly GO_MOD=$'module example.com/fixture\n\ngo 1.22\n'
# gofumpt's own rule: an octal literal takes the 0o prefix from go1.13 on.
readonly UNFORMATTED_GO=$'package x\n\nfunc f() {\n\t_ = 0755\n}\n'
readonly FORMATTED_GO=$'package x\n\nfunc f() {\n\t_ = 0o755\n}\n'
# goimports' grouping: stdlib, then third-party, then the root module's own
# packages. fmt is used but not imported, which -format-only leaves alone.
readonly UNGROUPED_GO=$'package x\n\nimport (\n\t"example.com/fixture/sub"\n\t"example.org/other/pkg"\n\t"os"\n)\n\nfunc f() {\n\t_ = os.Exit\n\t_ = pkg.X\n\t_ = sub.Y\n\t_ = fmt.Println\n}\n'
readonly GROUPED_GO=$'package x\n\nimport (\n\t"os"\n\n\t"example.org/other/pkg"\n\n\t"example.com/fixture/sub"\n)\n\nfunc f() {\n\t_ = os.Exit\n\t_ = pkg.X\n\t_ = sub.Y\n\t_ = fmt.Println\n}\n'
readonly GENERATED_GO=$'// Code generated by stub. DO NOT EDIT.\n\n'"${UNFORMATTED_GO}"

function setup_file() {
  load e2e_helper
  require_image
}

function setup() {
  load e2e_helper
  make_consumer "${BATS_TEST_TMPDIR}/repo"
  write_file go.mod "${GO_MOD}"
  write_file pkg/ok.go "${FORMATTED_GO}"
  commit_all 'go module'
}

# @description Write and commit two unformatted Go files: one gofumpt
#              rewrites, and one whose imports goimports regroups.
# @noargs
function commit_unformatted() {
  write_file cmd/main.go "${UNFORMATTED_GO}"
  write_file pkg/imports.go "${UNGROUPED_GO}"
  commit_all 'unformatted'
}

@test 'check-go-formatted passes a formatted tree' {
  run hook_run run --hook pre-commit check-go-formatted
  assert_success
  assert_line '== check-go-formatted: pass =='
}

@test 'check-go-formatted finds an unformatted file and ungrouped imports' {
  commit_unformatted
  run hook_run run --hook pre-commit check-go-formatted
  assert_failure 1
  assert_line '== check-go-formatted: fail =='
  assert_line 'cmd/main.go: not formatted'
  assert_line 'pkg/imports.go: not formatted'
  assert_line '2 file(s)'
  refute_line 'pkg/ok.go: not formatted'
  # Check mode writes nothing.
  assert_content cmd/main.go "${UNFORMATTED_GO}"
}

@test 'fmt go rewrites the files in place, keeping owner, mode bits and inode' {
  commit_unformatted
  chmod 0640 cmd/main.go
  local inode_before
  inode_before="$(stat --format '%i' cmd/main.go)"
  run rw_hook_run fmt go
  assert_success
  assert_line '== go: formatted =='
  assert_line 'cmd/main.go: formatted'
  assert_line 'pkg/imports.go: formatted'
  assert_line 'toolbelt: 2 file(s) formatted, 0 failed, 0 errored; review and stage them'
  assert_content cmd/main.go "${FORMATTED_GO}"
  assert_content pkg/imports.go "${GROUPED_GO}"
  assert_content pkg/ok.go "${FORMATTED_GO}"
  assert_equal "$(stat --format '%u:%g' cmd/main.go)" "${HOST_USER}"
  assert_equal "$(stat --format '%a' cmd/main.go)" '640'
  assert_equal "$(stat --format '%i' cmd/main.go)" "${inode_before}"
}

@test 'fmt --fail-on-change go exits 1 after a rewrite' {
  commit_unformatted
  run rw_hook_run fmt --fail-on-change go
  assert_failure 1
  assert_line 'cmd/main.go: formatted'
  assert_content cmd/main.go "${FORMATTED_GO}"
}

@test 'fmt go with the read-only mount exits 2 giving the read-write line' {
  commit_unformatted
  run hook_run fmt go
  assert_failure 2
  # shellcheck disable=SC2016 # the expansions are the message's literal text
  assert_output --partial '--volume "${root}:${root}"'
  assert_content cmd/main.go "${UNFORMATTED_GO}"
}

@test 'an excluded file is neither reported nor rewritten' {
  write_file internal/legacy/old.go "${UNFORMATTED_GO}"
  printf 'check-go-formatted:\n  exclude:\n    - internal/legacy/**\n' >> .repo-toolbelt.yml
  commit_all 'excluded'
  run hook_run run --hook pre-commit check-go-formatted
  assert_success
  assert_line '== check-go-formatted: pass =='
  run rw_hook_run fmt go
  assert_success
  assert_line '== go: pass =='
  assert_content internal/legacy/old.go "${UNFORMATTED_GO}"
}

@test 'a file under vendor is neither reported nor rewritten' {
  write_file vendor/example.org/lib/lib.go "${UNFORMATTED_GO}"
  commit_all 'vendored'
  run git ls-files vendor
  assert_output 'vendor/example.org/lib/lib.go'
  run hook_run run --hook pre-commit check-go-formatted
  assert_success
  assert_line '== check-go-formatted: pass =='
  run rw_hook_run fmt go
  assert_success
  assert_line '== go: pass =='
  assert_content vendor/example.org/lib/lib.go "${UNFORMATTED_GO}"
}

@test 'a generated file is neither reported nor rewritten' {
  write_file pkg/gen.go "${GENERATED_GO}"
  commit_all 'generated'
  run hook_run run --hook pre-commit check-go-formatted
  assert_success
  assert_line '== check-go-formatted: pass =='
  run rw_hook_run fmt go
  assert_success
  assert_line '== go: pass =='
  assert_content pkg/gen.go "${GENERATED_GO}"
}

@test 'no go.mod at the repo root exits 2 naming it, in the lint and in fmt' {
  git rm --quiet -- go.mod
  commit_all 'no go.mod'
  run hook_run run --hook pre-commit check-go-formatted
  assert_failure 2
  assert_line '== check-go-formatted: error =='
  assert_output --partial 'cannot read go.mod at the repo root'
  run rw_hook_run fmt go
  assert_failure 2
  assert_line '== go: error =='
  assert_output --partial 'cannot read go.mod at the repo root'
  assert_content pkg/ok.go "${FORMATTED_GO}"
}
