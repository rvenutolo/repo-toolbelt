#!/usr/bin/env bash

# @description The full verification gate, verify-only: the formatting of the
#              Nix, YAML and JSON files (nix flake check), the Go module
#              vendor hash in nix/toolbelt.nix, the lint suite,
#              the example consumer files' check, the Go and BATS test suites,
#              then this repo's lints through the runner built from this
#              commit, the dogfooded formatters' checks among them (each runs
#              the formatter built beside it), the coverage lints on the
#              reports the tests wrote, the baseline-slack check, and
#              check-toolbelt-pins over the example files. Exit codes
#              aggregate, so one run surfaces every failing category. Every
#              caller (the pre-push hook, the .justfile and CI) runs it
#              through .ci/in-devshell, so local and CI runs cannot drift.
# @noargs
# @exitcode 0 every check passed.
# @exitcode 1 one or more checks failed.

set -Eeuo pipefail
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

# shellcheck source=.ci/dogfood-formatters.bash
source "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/.ci/dogfood-formatters.bash"

# `inherit_errexit` needs bash 4.4+; the devShell's bash provides it.
shopt -s inherit_errexit

# Every lint that fits this repo, run through the built runner as CI runs
# them, the dogfooded formatters' check lints included. check-toolbelt-pins is
# not among them: it checks consumers' pins, so it runs over the example
# consumer files instead.
readonly DOGFOOD_LINTS=(check-workflow-hermetic check-issue-numbers "${DOGFOOD_FORMATTER_CHECKS[@]}")
readonly COVERAGE_LINTS=(check-coverage-drop check-patch-coverage)

# Scratch directory: command output (no process substitution) and the built
# layout. A script-level variable, not a local: the single-quoted EXIT trap
# expands it at exit, after any function's locals are gone.
TMP_DIR="$(mktemp --directory)"
readonly TMP_DIR
trap 'rm --recursive --force -- "${TMP_DIR}"' EXIT
readonly TMP_FILE="${TMP_DIR}/output"
readonly DIST_DIR="${TMP_DIR}/dist"

# @description Write a timestamped, levelled line to stderr.
# @arg $1 level severity label
# @arg $2 message text to print
function log() {
  local -r level="$1"
  local -r message="$2"
  printf '[%s] %-5s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "${level}" "${message}" >&2
}

# @description Write an INFO line to stderr.
# @arg $@ message text to print
function log_info() {
  log INFO "$*"
}

# @description Write a WARN line to stderr.
# @arg $@ message text to print
function log_warn() {
  log WARN "$*"
}

# @description Write an ERROR line to stderr.
# @arg $@ message text to print
function log_err() {
  log ERROR "$*"
}

# @description Warn about untracked files. `nix flake check` evaluates the git
#              tree, so an untracked file is invisible to the formatting gate
#              and passes vacuously. Warns, never fails.
# @noargs
function warn_untracked() {
  git ls-files --others --exclude-standard > "${TMP_FILE}"
  if [[ ! -s "${TMP_FILE}" ]]; then
    return 0
  fi
  log_warn 'untracked files are invisible to nix flake check; git add them:'
  local untracked_file
  while IFS= read -r untracked_file; do
    log_warn "  untracked: ${untracked_file}"
  done < "${TMP_FILE}" # coverage-exempt: kcov scores this line; it never executes as bash
}

# @description Run the dogfooded lints through the built runner, judging the
#              change since the fork point from origin/main. The coverage
#              lints read the reports the tests just wrote. A formatter's
#              check runs the formatter's executable, so the runner finds the
#              formatters in the built layout as it finds the lints.
# @arg $@ lints names of the lints to run
function run_dogfood_lints() {
  # Only --hook ci takes an explicit --base and --head; outside Actions its
  # ::stop-commands:: and ::error lines are expected noise.
  TOOLBELT_LINTS_DIR="${DIST_DIR}/lints" TOOLBELT_FORMATTERS_DIR="${DIST_DIR}/formatters" \
    "${DIST_DIR}/bin/toolbelt" run --hook ci --base origin/main --head HEAD --default-branch main "$@"
}

# @description Fail when the committed coverage baseline differs from what the
#              updater would write from the reports the tests just wrote, so
#              slack left by new markers or tests cannot let untested code in.
#              Reads only; the working tree is never modified.
# @noargs
function check_baseline_slack() {
  "${DIST_DIR}/bin/toolbelt" update-coverage-baseline --check
}

# @description Run the built check-toolbelt-pins with examples/consumer as its
#              repo root and no config section, as the runner would in a
#              consumer. It reads files only, so it needs no repository there.
# @noargs
function run_pins_over_examples() {
  local -r section_file="${TMP_DIR}/null-section.json"
  printf 'null\n' > "${section_file}"
  env --chdir="${REPO_DIR}/examples/consumer" TOOLBELT_SECTION="${section_file}" TOOLBELT_HOOK=ci \
    "${DIST_DIR}/lints/check-toolbelt-pins/check-toolbelt-pins"
}

# @description Run every check and aggregate the exit codes.
# @noargs
function main() {
  local rc=0
  warn_untracked

  log_info 'running nix flake check (formatting)'
  nix flake check --no-eval-cache "${REPO_DIR}" || rc=1

  # The flake check builds no package, so a Go import that changes the module
  # set would leave nix/toolbelt.nix's vendorHash stale until the image build.
  # The modules alone build in seconds and fail on a hash mismatch.
  log_info 'checking the Go module vendor hash'
  nix build --no-link "${REPO_DIR}#toolbelt.goModules" || rc=1

  log_info 'running lint checks'
  "${REPO_DIR}/.ci/run-lint-checks" || rc=1

  log_info 'checking the example consumer files'
  "${REPO_DIR}/.ci/check-examples" || rc=1

  log_info 'running tests'
  local tests_rc=0
  "${REPO_DIR}/run-tests" || tests_rc=1

  if ((tests_rc != 0)); then
    rc=1
  fi
  log_info 'building the image layout from this commit'
  if "${REPO_DIR}/.ci/build-dist" "${DIST_DIR}"; then
    # Reports from failed or partial tests would add findings that only
    # repeat the test failure.
    if ((tests_rc == 0)); then
      log_info 'running the dogfooded lints, coverage lints included'
      run_dogfood_lints "${DOGFOOD_LINTS[@]}" "${COVERAGE_LINTS[@]}" || rc=1
      log_info 'checking the coverage baseline for slack'
      check_baseline_slack || rc=1
    else
      log_warn 'skipping the coverage lints: the tests failed, so their reports are not current'
      run_dogfood_lints "${DOGFOOD_LINTS[@]}" || rc=1
    fi
    log_info 'running check-toolbelt-pins over the example consumer files'
    run_pins_over_examples || rc=1
  else
    rc=1
  fi

  if ((rc != 0)); then
    log_err 'one or more checks failed'
  fi
  # A gate reporting its own verdict is not a crash: drop the ERR trap so the
  # diagnostics above are the last thing the reader sees.
  trap - ERR
  return "${rc}"
}

REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR
cd "${REPO_DIR}" || exit 1

main "$@"
