#!/usr/bin/env bash

# @description The full verification gate, verify-only: formatting (nix flake
#              check), the lint suite, the Go and BATS test suites, then the
#              coverage lints on the reports the tests wrote.
#              Exit codes aggregate, so one run surfaces every failing
#              category. Every caller (the pre-push hook, the .justfile and
#              CI) runs it through .ci/in-devshell, so local and CI runs
#              cannot drift.
# @noargs
# @exitcode 0 every check passed.
# @exitcode 1 one or more checks failed.

set -Eeuo pipefail
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

# bash 4.4 for `inherit_errexit`; the devShell's bash always satisfies this.
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
  printf '%s: bash 4.4+ required (found %s.%s)\n' "${0##*/}" "${BASH_VERSINFO[0]}" "${BASH_VERSINFO[1]}" >&2
  exit 1
fi
shopt -s inherit_errexit

# The coverage lints run on this repo's own reports, from this commit.
readonly COVERAGE_LINTS=(check-coverage-drop check-patch-coverage)
# Every Go lint is built, so a build break in any of them fails the gate.
readonly BUILT_LINTS=("${COVERAGE_LINTS[@]}" check-issue-numbers check-toolbelt-pins)

# Scratch directory: command output (no process substitution) and the built
# lints. A script-level variable, not a local: the single-quoted EXIT trap
# expands it at exit, after any function's locals are gone.
TMP_DIR="$(mktemp --directory)"
readonly TMP_DIR
trap 'rm --recursive --force -- "${TMP_DIR}"' EXIT
readonly TMP_FILE="${TMP_DIR}/output"

# @description Write a timestamped, levelled line to stderr.
# @arg $1 level severity label
# @arg $2 message text to print
function log() {
  local -r level="$1"
  local -r message="$2"
  printf '[%s] %-5s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "${level}" "${message}" >&2
}

# @description Write an INFO line to stderr.
# @arg $@ message text to print
function log_info() {
  log INFO "$*"
}

# @description Write a WARN line to stderr.
# @arg $@ message text to print
function log_warn() {
  log WARN "$*"
}

# @description Write an ERROR line to stderr.
# @arg $@ message text to print
function log_err() {
  log ERROR "$*"
}

# @description Warn about untracked files. `nix flake check` evaluates the git
#              tree, so an untracked file is invisible to the formatting gate
#              and passes vacuously. Warns, never fails.
# @noargs
function warn_untracked() {
  git ls-files --others --exclude-standard > "${TMP_FILE}"
  if [[ ! -s "${TMP_FILE}" ]]; then
    return 0
  fi
  log_warn 'untracked files are invisible to nix flake check; git add them:'
  local untracked_file
  while IFS= read -r untracked_file; do
    log_warn "  untracked: ${untracked_file}"
  done < "${TMP_FILE}" # coverage-exempt: kcov scores this line; it never executes as bash
}

# @description Run the coverage lints on the reports the tests just wrote,
#              through the runner as CI runs them, judging the change since
#              the fork point from origin/main. The lints are built from this
#              commit into the layout the runner reads.
#              TODO: build the lints with the repo's distribution build once
#              it exists, instead of here.
# @noargs
function check_own_coverage() {
  local -r lints_dir="${TMP_DIR}/lints"
  local lint
  for lint in "${BUILT_LINTS[@]}"; do
    go build -o "${lints_dir}/${lint}/${lint}" "./cmd/${lint}" || return 1
  done
  # Only --hook ci takes an explicit --base and --head; outside Actions its
  # ::stop-commands:: and ::error lines are expected noise.
  TOOLBELT_LINTS_DIR="${lints_dir}" go run ./cmd/toolbelt run --hook ci \
    --base origin/main --head HEAD --default-branch main "${COVERAGE_LINTS[@]}"
}

# @description Run every check and aggregate the exit codes.
# @noargs
function main() {
  local rc=0
  warn_untracked

  log_info 'running nix flake check (formatting)'
  nix flake check --no-eval-cache "${REPO_DIR}" || rc=1

  log_info 'running lint checks'
  "${REPO_DIR}/.ci/run-lint-checks" || rc=1

  log_info 'running tests'
  local tests_rc=0
  "${REPO_DIR}/run-tests" || tests_rc=1

  # Reports from failed or partial tests would add findings that only
  # repeat the test failure.
  if ((tests_rc == 0)); then
    log_info 'running the coverage lints on the test reports'
    check_own_coverage || rc=1
  else
    rc=1
    log_warn 'skipping the coverage lints: the tests failed, so their reports are not current'
  fi

  if ((rc != 0)); then
    log_err 'one or more checks failed'
  fi
  # A gate reporting its own verdict is not a crash: drop the ERR trap so the
  # diagnostics above are the last thing the reader sees.
  trap - ERR
  return "${rc}"
}

REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR
cd "${REPO_DIR}" || exit 1

main "$@"
