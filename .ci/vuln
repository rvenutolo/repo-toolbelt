#!/usr/bin/env bash

# @description Scan the module with govulncheck and fail on every reachable
#              vulnerability that SECURITY-EXCEPTIONS.md does not list.
#              govulncheck has no ignore list, so the exceptions are filtered
#              here. A reachable vulnerability is one whose trace starts at a
#              called function; modules and packages that are merely required
#              or imported are not findings. A scan that did not run, or whose
#              report cannot be read, is a failure, never a pass. Re-runs
#              itself inside the devShell when started outside it.
#
#              SECURITY-EXCEPTIONS.md lists one exception per line, in the
#              form `- <OSV id>: <reason>; review by <YYYY-MM-DD>`.
# @noargs
# @exitcode 0 no reachable vulnerability outside the exceptions.
# @exitcode 1 a reachable vulnerability, or the scan did not complete.

set -Eeuo pipefail
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

# An interactive `nix develop` or direnv shell leaves IN_DEVSHELL unset and the
# host PATH behind the flake's tools: a tool the flake lacks would resolve from
# the host. Re-run through in-devshell, which sets IN_DEVSHELL and so stops the
# recursion.
SELF_PATH="$(readlink --canonicalize -- "${BASH_SOURCE[0]}")"
SELF_REPO="${SELF_PATH%/*/*}"
if [[ -z "${IN_DEVSHELL:-}" ]]; then
  exec "${SELF_REPO}/.ci/in-devshell" "${SELF_PATH}" "$@"
fi

# `inherit_errexit` needs bash 4.4+; the devShell's bash provides it.
shopt -s inherit_errexit

# The module and the exceptions file are the script's own repo's, whatever
# directory it is run from.
cd -- "${SELF_REPO}" || exit 1

readonly EXCEPTIONS_FILE='SECURITY-EXCEPTIONS.md'
readonly EXCEPTION_RE='^- (GO-[0-9]{4}-[0-9]+):'

# One row per reachable vulnerability and module. A report always opens with a
# config message, so one without it is not a report.
readonly ROWS_FILTER='
  if any(.[]; has("config")) | not then error("no config message") else . end # coverage-exempt: kcov scores this line; it never executes as bash
  | [ .[] | .finding? // empty | select(.trace[0].function != null) # coverage-exempt: kcov scores this line; it never executes as bash
      | { osv, # coverage-exempt: kcov scores this line; it never executes as bash
          module: .trace[0].module, # coverage-exempt: kcov scores this line; it never executes as bash
          version: (.trace[0].version // "unknown"), # coverage-exempt: kcov scores this line; it never executes as bash
          fixed: (.fixed_version // "none released") } ] # coverage-exempt: kcov scores this line; it never executes as bash
  | unique_by([.osv, .module]) | .[] # coverage-exempt: kcov scores this line; it never executes as bash
  | [.osv, .module, .version, .fixed] # coverage-exempt: kcov scores this line; it never executes as bash
  | @tsv' # coverage-exempt: kcov scores this line; it never executes as bash

# @description Print the excepted OSV ids, one per line.
# @noargs
function excepted_ids() {
  [[ -f "${EXCEPTIONS_FILE}" ]] || return 0
  local line
  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${line}" =~ ${EXCEPTION_RE} ]]; then
      printf '%s\n' "${BASH_REMATCH[1]}"
    fi
  done < "${EXCEPTIONS_FILE}" # coverage-exempt: kcov scores this line; it never executes as bash
}

# @description Scan the module and judge the findings.
# @noargs
function main() {
  # A finding is this check's designed return, not a crash.
  trap - ERR

  # -format json: the text report is for people. In this format govulncheck
  # exits 0 whatever it finds, so a non-zero status means the scan itself broke.
  local report rows
  if ! report="$(go tool govulncheck -format json ./...)"; then
    printf 'FAIL: govulncheck did not complete; no vulnerability verdict\n' >&2
    return 1
  fi
  if ! rows="$(jq --slurp --raw-output "${ROWS_FILTER}" <<< "${report}")"; then
    printf "FAIL: could not read govulncheck's report; no vulnerability verdict\n" >&2
    return 1
  fi

  local excepted
  excepted="$(excepted_ids)"

  local rc=0 osv module version fixed
  while IFS=$'\t' read -r osv module version fixed; do
    [[ -n "${osv}" ]] || continue
    if grep --quiet --line-regexp --fixed-strings -- "${osv}" <<< "${excepted}"; then
      printf 'excepted: %s in %s@%s\n' "${osv}" "${module}" "${version}" >&2
      continue
    fi
    printf 'FAIL: %s in %s@%s, fixed in %s (https://pkg.go.dev/vuln/%s)\n' \
      "${osv}" "${module}" "${version}" "${fixed}" "${osv}" >&2
    rc=1
  done <<< "${rows}"
  return "${rc}"
}

main "$@"
