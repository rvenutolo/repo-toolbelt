#!/usr/bin/env bash

# @description Run a command inside this repo's Nix devShell with a hermetic
#              environment. The single entrypoint for every gate: every gate
#              script and git hook re-runs itself through it when started
#              outside the devShell, and the .justfile recipes and every CI
#              step go through it, so local and CI runs cannot drift and no
#              gate can silently resolve a tool from the ambient machine.
#
#              `nix develop --ignore-environment` is what makes the boundary
#              real: without it the devShell inherits the caller's PATH and an
#              undeclared dependency keeps resolving from /usr/bin. Because the
#              environment is wiped, the few variables the gates genuinely need
#              are re-admitted through the fixed KEEP_VARS allowlist below.
#
#              When IN_DEVSHELL is already set the command is run directly,
#              with no second nix evaluation: the caller is inside the
#              boundary.
#
#              The flake is the repo this script lives in, found from the
#              script's own resolved path rather than the caller's working
#              directory, so a gate script reached through a symlink from any
#              directory enters the right devShell. The command itself still
#              runs in the caller's working directory.
#
#              `nix develop` makes temp directories of its own and execs the
#              command, so nothing it leaves would ever be removed. The script
#              therefore runs it as a child inside a private directory made
#              under the caller's TMPDIR, with TMPDIR kept and pointing there,
#              and deletes that directory once the command has ended, however
#              it ends. Everything nix and the command write to TMPDIR goes
#              with it.
#
#              "The command" is the direct child, nix and what it execs. The
#              directory is removed only after that child exits, and not on a
#              signal alone: a command that catches one keeps running in it.
#              Processes the command leaves running in the background are not
#              waited for. SIGTERM and SIGHUP are forwarded to the command
#              only, so a command that dies without passing one on can leave
#              descendants running after the directory is gone; `timeout` and
#              CI cancellation signal the whole process group, which reaches
#              them. A SIGINT sent to this script alone, not to the foreground
#              process group, is not forwarded at all: a Ctrl-C already
#              reaches the command through the process group, and forwarding
#              would deliver it twice.
#
#              Standalone on purpose: it runs before the environment it
#              creates, so it needs only bash 4.4+, git, GNU coreutils
#              (dirname, mktemp, readlink, rm) and nix from the host. Every
#              script that re-runs itself through this wrapper has the same
#              requirement before the devShell exists.
# @arg $@ command the command to run inside the devShell, plus its arguments
# @stderr the usage line, or the reason the script cannot run
# @exitcode 0 the wrapped command succeeded
# @exitcode 1 no command given, the script is not inside a git repo, TMPDIR
#             names no directory, or the host bash is too old
# @exitcode 129 hung up once the private temp directory exists and before the
#               command starts (130 interrupted, 143 terminated). The signal
#               traps are set only once that directory is recorded, so a
#               signal that lands earlier takes the shell's default action
#               and ends the script, which the caller sees as 128+N
# @exitcode * otherwise the wrapped command's exit status (128+N when a signal
#             killed it, or when bash lost the status of a command that ended
#             during a forwarded signal), nix's own when the devShell cannot be
#             entered, or the failing mktemp or readlink status

set -Eeuo pipefail
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

# This script runs under the HOST bash, before the devShell it creates exists,
# so the host's version is whatever the machine ships. `shopt -s
# inherit_errexit` below needs bash 4.4: on stock macOS bash 3.2 the shell
# aborts with `shopt: inherit_errexit: invalid shell option name`, which tells
# the user nothing about what to install. Check first, and say what to do.
# Must stay ABOVE the `shopt` line it protects. The GNU long options of
# readlink, mktemp and rm used below are a host requirement too, stated in the
# header.
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
  msg="${0##*/}: bash 4.4+ required to run the gate"      # coverage-exempt: the test bash is always 4.4+
  printf '%s (found %s)\n' "${msg}" "${BASH_VERSION}" >&2 # coverage-exempt: the test bash is always 4.4+
  exit 1                                                  # coverage-exempt: the test bash is always 4.4+
fi
# Without this, errexit is off inside every $(...) subshell, so the `tmp_dir`
# substitution, which nests a readlink inside a mktemp, would run past a failed
# readlink.
shopt -s inherit_errexit

# `--keep` on an unset variable is silent and harmless, so every name is passed
# unconditionally rather than set-checked. HOME is a deliberate residue: gh
# auth, the nix config and the Go build and module caches live there (Go needs
# a writable cache under HOME), so host dotfiles such as ~/.shellcheckrc can
# still shape a LOCAL run in ways a clean CI HOME will not. TMPDIR points at
# the private directory made below, so what nix and the command write there is
# removed with it. The Go and XDG_CACHE_HOME variables let a caller relocate
# those caches; DOCKER_HOST points the docker client at a non-default daemon.
readonly KEEP_VARS=(
  HOME                # coverage-exempt: kcov scores this line; it never executes as bash
  TERM                # coverage-exempt: kcov scores this line; it never executes as bash
  CI                  # coverage-exempt: kcov scores this line; it never executes as bash
  IN_DEVSHELL         # coverage-exempt: kcov scores this line; it never executes as bash
  NIX_SSL_CERT_FILE   # coverage-exempt: kcov scores this line; it never executes as bash
  TMPDIR              # coverage-exempt: kcov scores this line; it never executes as bash
  GITHUB_ACTIONS      # coverage-exempt: kcov scores this line; it never executes as bash
  GITHUB_OUTPUT       # coverage-exempt: kcov scores this line; it never executes as bash
  GITHUB_ENV          # coverage-exempt: kcov scores this line; it never executes as bash
  GITHUB_STEP_SUMMARY # coverage-exempt: kcov scores this line; it never executes as bash
  GITHUB_WORKSPACE    # coverage-exempt: kcov scores this line; it never executes as bash
  GITHUB_REPOSITORY   # coverage-exempt: kcov scores this line; it never executes as bash
  GITHUB_REF          # coverage-exempt: kcov scores this line; it never executes as bash
  GITHUB_REF_NAME     # coverage-exempt: kcov scores this line; it never executes as bash
  GITHUB_SHA          # coverage-exempt: kcov scores this line; it never executes as bash
  GITHUB_EVENT_NAME   # coverage-exempt: kcov scores this line; it never executes as bash
  GITHUB_TOKEN        # coverage-exempt: kcov scores this line; it never executes as bash
  GH_TOKEN            # coverage-exempt: kcov scores this line; it never executes as bash
  GH_REPO             # coverage-exempt: kcov scores this line; it never executes as bash
  RUNNER_OS           # coverage-exempt: kcov scores this line; it never executes as bash
  RUNNER_TEMP         # coverage-exempt: kcov scores this line; it never executes as bash
  GOFLAGS             # coverage-exempt: kcov scores this line; it never executes as bash
  GOPATH              # coverage-exempt: kcov scores this line; it never executes as bash
  GOCACHE             # coverage-exempt: kcov scores this line; it never executes as bash
  GOMODCACHE          # coverage-exempt: kcov scores this line; it never executes as bash
  XDG_CACHE_HOME      # coverage-exempt: kcov scores this line; it never executes as bash
  DOCKER_HOST         # coverage-exempt: kcov scores this line; it never executes as bash
)                     # coverage-exempt: kcov scores this line; it never executes as bash

# Global, not local to main: the EXIT trap runs after main has returned.
tmp_dir=''
child_pid=''
got_signal=''

# @description Remove the private temp directory, if one was made. Run by the
#              EXIT trap.
# @noargs
# shellcheck disable=SC2329 # invoked by the EXIT trap in main
function remove_tmp_dir() {
  if [[ -n "${tmp_dir}" ]]; then
    rm --recursive --force -- "${tmp_dir:?}"
  fi
}

# @description Handle a signal while the command runs. A Ctrl-C reaches the
#              child through the shared process group, so SIGINT is not
#              forwarded: a second copy would read as a second Ctrl-C, which
#              makes a command abort its own cleanup. SIGTERM and SIGHUP are
#              usually sent to this script alone, and reach the child only
#              through this forward. The traps stay set, so every further
#              signal is handled too, and main keeps waiting until the child
#              has ended: the directory is never removed under a child still
#              running, and the exit status is the child's own. A signal
#              landing between the launch and the assignment of child_pid
#              finds the child through `$!`; before the launch `$!` is unset
#              and there is nothing to wait for, so the script exits at once
#              with the conventional status. The status is also recorded in
#              got_signal, for main's wait loop.
# @arg $1 signal_name HUP, INT or TERM
# @arg $2 status the conventional 128+N status for that signal
# shellcheck disable=SC2329 # invoked by the INT, TERM and HUP traps in main
function on_signal() {
  local -r signal_name="$1"
  local -r status="$2"
  child_pid="${child_pid:-${!:-}}"
  if [[ -z "${child_pid}" ]]; then
    exit "${status}" # coverage-exempt: a signal between the trap and the launch; no test can time it
  fi
  got_signal="${status}"
  if [[ "${signal_name}" != 'INT' ]]; then
    kill -s "${signal_name}" "${child_pid}" 2> '/dev/null' || true
  fi
}

# @description Run the given command inside the devShell of the repo this
#              script lives in, and wait for it.
# @arg $@ command the command to run, plus its arguments
function main() {
  if (($# == 0)); then
    printf 'usage: %s <command> [args...]\n' "${0##*/}" >&2
    exit 1
  fi

  # Already inside the boundary: run directly, skip a second nix evaluation.
  if [[ -n "${IN_DEVSHELL:-}" ]]; then
    exec "$@"
  fi

  # The flake reference is the repo this script lives in, found from its own
  # resolved path and never from the caller's working directory: a gate must
  # evaluate the tree it is grading, also when reached through a symlink from
  # elsewhere. Git exports GIT_DIR to the hooks it runs, and with GIT_DIR set
  # and no GIT_WORK_TREE, rev-parse names the -C directory itself as the top
  # level, so both are unset in the substitution's subshell for this one call.
  local wrapper_dir repo_dir
  wrapper_dir="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")"
  if ! repo_dir="$(unset GIT_DIR GIT_WORK_TREE && git -C "${wrapper_dir}" rev-parse --show-toplevel 2> '/dev/null')"; then
    printf '%s: not a git repo: %s\n' "${0##*/}" "${wrapper_dir}" >&2
    exit 1
  fi
  readonly wrapper_dir repo_dir

  export IN_DEVSHELL=1

  local -a nix_args=(develop "${repo_dir}" --ignore-environment)
  local keep_var
  for keep_var in "${KEEP_VARS[@]}"; do
    nix_args+=(--keep "${keep_var}")
  done
  nix_args+=(--command)

  local -r parent_dir="${TMPDIR:-/tmp}"
  if [[ ! -d "${parent_dir}" ]]; then
    printf '%s: TMPDIR %s names no directory\n' "${0##*/}" "${parent_dir}" >&2
    exit 1
  fi
  trap remove_tmp_dir EXIT
  # Absolute, because nix rejects a relative TMPDIR and the command could not
  # use one after changing directory.
  tmp_dir="$(mktemp --directory --tmpdir="$(readlink --canonicalize -- "${parent_dir}")" in-devshell.XXXXXX)"
  export TMPDIR="${tmp_dir}"
  # Set only once tmp_dir is assigned, so on_signal never exits while mktemp's
  # directory exists but tmp_dir, which the EXIT trap reads, is still empty.
  # Before this point a signal takes its default action.
  trap 'on_signal HUP 129' HUP
  trap 'on_signal INT 130' INT
  trap 'on_signal TERM 143' TERM

  # Run in the background only so `wait` can be interrupted by the traps above;
  # a foreground child would hold them off until it exited. Without job control
  # bash starts a background child with SIGINT and SIGQUIT ignored and stdin on
  # /dev/null, so the subshell restores both signals and stdin is passed
  # explicitly: the command behaves as it would in the foreground.
  ( # coverage-exempt: kcov scores this line; it never executes as bash
    trap - INT QUIT
    exec nix "${nix_args[@]}" "$@"
  ) <&0 & # coverage-exempt: kcov scores this line; it never executes as bash
  child_pid="$!"
  # Two races decide the loop. A forwarded signal can land between the loop
  # top and the start of `wait`: the trap runs first, and `wait` blocks and
  # returns the child's real status. And after a `wait` a trap cut short, the
  # child may end before anything could check whether it still runs. So after
  # every wait a trap cut short the loop simply waits again: a wait on a child
  # bash has already reaped returns its saved status, so a command that handles
  # the signal and exits 0 is reported as 0. Only when bash lost that status,
  # because the child ended during the very wait a trap cut short, does the
  # next wait find no such child (5.2 reports 255, 5.3 reports 127, with a
  # message silenced here); then the conventional 128+N of the last signal
  # stands in, so a real 127 or 255 after a forwarded signal is reported as
  # 128+N too. That substitution is one line so kcov scores it on every pass:
  # the lost status is a race no test can produce on demand.
  local rc=0
  local signal_status=''
  while true; do
    got_signal=''
    rc=0
    wait "${child_pid}" 2> '/dev/null' || rc="$?"
    if [[ -n "${got_signal}" ]]; then
      signal_status="${got_signal}"
      continue
    fi
    [[ -n "${signal_status}" ]] && ((rc == 127 || rc == 255)) && rc="${signal_status}"
    break
  done
  exit "${rc}"
}

main "$@"
