#!/usr/bin/env bash

# @description Format Go files with gofumpt, then goimports, to the formatter
#              calling convention (README "The formatter calling convention").
#              The files come NUL-terminated in the file TOOLBELT_FILES names.
#              A generated file, one with a `// Code generated ... DO NOT
#              EDIT.` line before its package clause, is dropped from the list
#              before any tool runs; with no file left, nothing else happens,
#              and no go.mod is needed.
#
#              Each file goes through `gofumpt <file>`, by path, so a parse
#              error names the file and gofumpt takes the language version
#              from the go.mod nearest the file; then through `goimports
#              -format-only -local <module>`, which regroups imports into
#              stdlib, third-party and module-local but never adds or removes
#              one. `<module>` is the module path of the go.mod at the repo
#              root, whatever module the file is in. `-local` is a prefix
#              match on the import path as a string: an import whose path
#              starts with `<module>` is local, which covers the module's own
#              packages, a nested module whose path extends the root's and a
#              sibling such as `example.com/rootless` for the root
#              `example.com/root`; every other non-standard import is
#              third-party.
#              The formatter takes no settings; the runner has already
#              validated the section in the file TOOLBELT_SECTION names.
#
#              Check mode (TOOLBELT_MODE=check) writes nothing. Write mode
#              (TOOLBELT_MODE=write) copies each changed result over the
#              file's content in place, never by rename, so the file keeps its
#              inode, owner, mode bits and hard links, and no temp file
#              appears in the checkout. Every intermediate result stays in a
#              temp file under TMPDIR, never in a shell variable, which would
#              drop trailing newlines and NUL bytes.
#
#              gofumpt exits 2 for a parse error and for any other failure
#              alike, so its stderr decides: records
#              `<path>:<line>:<col>: <message>` naming the file are a parse
#              finding, and anything else is a setup failure.
# @arg $1 --help print usage and exit
# @stdout the usage line, with --help; otherwise one line per finding, in the
#         order of the file list: `<path>: not formatted` (check mode only) or
#         `<path>: cannot be parsed: <line>:<col>: <message>`, several
#         messages joined by `; `, then `<N> file(s)`
# @stderr one line naming a setup failure
# @exitcode 0 check mode: every file is formatted; write mode: every file is
#             now formatted
# @exitcode 1 a finding
# @exitcode 2 a setup failure: an unexpected argument, gofumpt or goimports
#             missing, an unset or bad TOOLBELT_MODE, TOOLBELT_FILES or
#             TOOLBELT_SECTION, a missing or module-less root go.mod, a file
#             that cannot be read or written, gofumpt failing other than on a
#             parse error, goimports failing, or an internal failure

set -Eeuo pipefail
IFS=$'\n\t'

# An unexpected failure is a crash, not a finding, so it exits with the
# setup-failure status rather than errexit's status of the failed command.
trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2; exit 2' ERR

# `inherit_errexit`, namerefs and associative arrays need bash 4.4+; the image's bash provides it.

# Found relative to this script's resolved path, never through the environment,
# so the source tree and the image share one layout.
# shellcheck source=lib/toolbelt.bash
source "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/../../lib/toolbelt.bash"

shopt -s inherit_errexit

readonly FORMATTER='go'
readonly USAGE="usage: ${FORMATTER} [--help]"
readonly GO_MOD='go.mod'

# Go's convention for a generated file (https://go.dev/s/generatedcode), which
# counts only before the package clause.
readonly GENERATED_PATTERN='^// Code generated .* DO NOT EDIT\.$'
readonly PACKAGE_PATTERN='^[[:space:]]*package([[:space:]]|$)'
# A module line, its path bare, double-quoted or backquoted, and an optional
# trailing comment.
# shellcheck disable=SC2016 # the backticks are go.mod's raw-string quotes, literal regex text
readonly MODULE_PATTERN='^[[:space:]]*module[[:space:]]+("([^"]*)"|`([^`]*)`|([^[:space:]]+))[[:space:]]*(//.*)?$'
# What follows `<path>:` in a parse error: the position, then a message that
# runs to the end of its line. Kept in a variable because a newline cannot be
# spelled inside `[[ =~ ]]`.
readonly PARSE_TAIL_PATTERN=$'^([0-9]+:[0-9]+: [^\n]*)(\n|$)'

# @description Store, in the named variable, the module path of the go.mod at
#              the repo root. Dies when there is none, or it has no module
#              line.
# @arg $1 result_var name of the variable to set
function read_module() {
  local -n module_ref="$1"
  if [[ ! -f "${GO_MOD}" ]] || ! { : < "${GO_MOD}"; } 2> '/dev/null'; then
    toolbelt::die "cannot read ${GO_MOD} at the repo root"
  fi
  local line
  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${line}" =~ ${MODULE_PATTERN} ]]; then
      # shellcheck disable=SC2034 # set through the nameref; the caller reads it
      module_ref="${BASH_REMATCH[2]}${BASH_REMATCH[3]}${BASH_REMATCH[4]}"
      if [[ -n "${module_ref}" ]]; then
        return 0
      fi
    fi
  done < "${GO_MOD}" # coverage-exempt: kcov scores this line; it never executes as bash
  toolbelt::die "${GO_MOD} has no module line"
}

# @description Succeed when the file carries a generated marker before its
#              package clause. Reads no further than the package clause.
# @arg $1 path the file's path
function is_generated() {
  local -r path="$1"
  local line
  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${line}" =~ ${GENERATED_PATTERN} ]]; then
      return 0
    fi
    if [[ "${line}" =~ ${PACKAGE_PATTERN} ]]; then
      return 1
    fi
  done < "${path}" # coverage-exempt: kcov scores this line; it never executes as bash
  return 1
}

# @description Store, in the named variable, gofumpt's parse messages for one
#              file: every record of its stderr must name the file, by its
#              path or by the argument gofumpt was given, then
#              `:<line>:<col>: <message>`. gofumpt reports `./-` as `-`, so
#              either name is accepted. Matching the name as a prefix, rather
#              than splitting on newlines first, keeps a path that holds a
#              newline in one record. Dies on any other stderr.
# @arg $1 result_var name of the variable to set
# @arg $2 path the file's path
# @arg $3 arg the argument gofumpt was given
# @arg $4 err_file gofumpt's stderr
function parse_messages() {
  local -n messages_ref="$1"
  local -r path="$2"
  local -r arg="$3"
  local -r err_file="$4"
  local shown
  toolbelt::printable shown "${path}"
  local text
  text="$(< "${err_file}")"
  if [[ -z "${text}" ]]; then
    toolbelt::die "gofumpt failed on ${shown} with no output"
  fi
  local rest="${text}" tail messages=''
  while [[ -n "${rest}" ]]; do
    if [[ "${rest}" == "${arg}:"* ]]; then
      tail="${rest#"${arg}:"}"
    elif [[ "${rest}" == "${path}:"* ]]; then
      tail="${rest#"${path}:"}"
    else
      toolbelt::die "gofumpt failed on ${shown}: ${text}"
    fi
    if [[ ! "${tail}" =~ ${PARSE_TAIL_PATTERN} ]]; then
      toolbelt::die "gofumpt failed on ${shown}: ${text}"
    fi
    messages="${messages:+${messages}; }${BASH_REMATCH[1]}"
    rest="${tail:${#BASH_REMATCH[0]}}"
  done
  # shellcheck disable=SC2034 # set through the nameref; the caller reads it
  messages_ref="${messages}"
}

# @description Format one file into a temp file under TMPDIR, and report
#              whether it parsed: the formatted text goes to out_file, and a
#              parse message, when gofumpt cannot parse the file, to the named
#              variable.
# @global TMP_DIR the run's scratch directory
# @global MODULE the root module path
# @arg $1 result_var name of the variable to set to the parse message, or ''
# @arg $2 path the file's path
# @arg $3 arg the argument gofumpt is given for it
# @arg $4 out_file where the formatted text goes
function format_file() {
  local -n parse_ref="$1"
  local -r path="$2"
  local -r arg="$3"
  local -r out_file="$4"
  local -r fumpted_file="${TMP_DIR}/gofumpt"
  local -r err_file="${TMP_DIR}/stderr"
  local shown
  toolbelt::printable shown "${path}"
  # shellcheck disable=SC2034 # set through the nameref; the caller reads it
  parse_ref=''
  local status=0
  gofumpt -- "${arg}" > "${fumpted_file}" 2> "${err_file}" || status=$?
  case "${status}" in
    0) ;; # coverage-exempt: kcov scores this line; it never executes as bash
    2)
      parse_messages parse_ref "${path}" "${arg}" "${err_file}"
      return 0
      ;;
    *) toolbelt::die "gofumpt exited ${status} on ${shown}: $(< "${err_file}")" ;;
  esac
  if ! goimports -format-only -local "${MODULE}" < "${fumpted_file}" > "${out_file}" 2> "${err_file}"; then
    toolbelt::die "goimports failed on ${shown}: $(< "${err_file}")"
  fi
}

# @description Check or format every listed file that is not generated, and
#              report the findings.
# @global TOOLBELT_MODE check or write
# @global PATHS the listed files
# @global ARGS the argument each file is passed to gofumpt as
# @global TMP_DIR the run's scratch directory
# @noargs
function main() {
  local -a indices=()
  local index shown
  for index in "${!PATHS[@]}"; do
    toolbelt::printable shown "${PATHS[index]}"
    if ! { : < "${PATHS[index]}"; } 2> '/dev/null'; then
      toolbelt::die "cannot read ${shown}"
    fi
    if ! is_generated "${PATHS[index]}"; then
      indices+=("${index}")
    fi
  done
  if ((${#indices[@]} == 0)); then
    return 0
  fi

  read_module MODULE

  local -r formatted_file="${TMP_DIR}/formatted"
  local findings=0 message parse_message formatted_hash file_hash
  for index in "${indices[@]}"; do
    toolbelt::printable shown "${PATHS[index]}"
    format_file parse_message "${PATHS[index]}" "${ARGS[index]}" "${formatted_file}"
    if [[ -n "${parse_message}" ]]; then
      toolbelt::printable message "${parse_message}"
      printf '%s: cannot be parsed: %s\n' "${shown}" "${message}"
      findings=$((findings + 1))
      continue
    fi
    # Hashed under errexit, so a failed hash is a crash rather than a match.
    formatted_hash="$(sha256sum < "${formatted_file}")"
    file_hash="$(sha256sum < "${PATHS[index]}")"
    if [[ "${formatted_hash}" != "${file_hash}" ]]; then
      if [[ "${TOOLBELT_MODE}" == 'write' ]]; then
        if ! cat -- "${formatted_file}" > "${PATHS[index]}"; then
          toolbelt::die "cannot write ${shown}"
        fi
      else
        printf '%s: not formatted\n' "${shown}"
        findings=$((findings + 1))
      fi
    fi
  done

  if ((findings > 0)); then
    printf '%d file(s)\n' "${findings}"
    exit 1
  fi
}

case "$#" in
  0) ;; # coverage-exempt: kcov scores this line; it never executes as bash
  1)
    case "$1" in
      --help)
        printf '%s\n' "${USAGE}"
        exit 0
        ;;
      *) toolbelt::die "unexpected argument '$1'; ${USAGE}" ;;
    esac
    ;;
  *) toolbelt::die "expected at most one argument, got $#; ${USAGE}" ;;
esac

for tool in gofumpt goimports; do
  if ! command -v "${tool}" > '/dev/null' 2>&1; then
    toolbelt::die "${tool} not found on PATH"
  fi
done
unset tool

case "${TOOLBELT_MODE:-}" in
  check | write) ;; # coverage-exempt: kcov scores this line; it never executes as bash
  *) toolbelt::die "TOOLBELT_MODE must be 'check' or 'write', got '${TOOLBELT_MODE:-}'" ;;
esac
readonly TOOLBELT_MODE

if [[ -z "${TOOLBELT_FILES:-}" ]]; then
  toolbelt::die 'TOOLBELT_FILES is not set'
fi
if [[ ! -f "${TOOLBELT_FILES}" || ! -r "${TOOLBELT_FILES}" ]]; then
  toolbelt::die "cannot read the file list ${TOOLBELT_FILES}"
fi

if [[ -z "${TOOLBELT_SECTION:-}" ]]; then
  toolbelt::die 'TOOLBELT_SECTION is not set'
fi
if [[ ! -f "${TOOLBELT_SECTION}" ]]; then
  toolbelt::die "TOOLBELT_SECTION names no file: ${TOOLBELT_SECTION}"
fi

# The files, in list order, and the argument each is passed to gofumpt as. A
# path that is exactly `-` is passed as `./-`, because gofumpt reads stdin for
# a `-` even after `--`.
declare -a PATHS=()
declare -a ARGS=()
mapfile -d '' -t PATHS < "${TOOLBELT_FILES}"
for index in "${!PATHS[@]}"; do
  case "${PATHS[index]}" in
    -) ARGS[index]='./-' ;;
    *) ARGS[index]="${PATHS[index]}" ;;
  esac
done
unset index
readonly PATHS ARGS

# The root module path, read only once a file is left to format.
MODULE=''

# One scratch directory per run under TMPDIR, never in the checkout, removed
# on any exit. Script-level, not local: the single-quoted EXIT trap expands it
# at exit, after any function's locals are gone.
TMP_DIR="$(mktemp --directory)"
readonly TMP_DIR
trap 'rm --recursive --force -- "${TMP_DIR}"' EXIT

main "$@"
