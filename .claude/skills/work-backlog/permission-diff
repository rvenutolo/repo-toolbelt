#!/usr/bin/env bash

# @description Print the permission rules a run needs that no settings file
#              allows yet, so the permission request names exactly the missing
#              rule strings. A rule counts as present only when some settings
#              file lists it verbatim: wildcard coverage between rules is
#              Claude Code's to judge, and a false "missing" costs one line in
#              the request where a false "present" costs a prompt mid-run. A
#              missing `Bash(...)` rule that a wider `Bash(<prefix> *)` rule in
#              some file covers by prefix is followed by a `covered by:` line
#              naming the most specific such rule, a hint for the reader that
#              changes no verdict.
#              Reads permissions.allow from the files Claude Code reads:
#              $CLAUDE_CONFIG_DIR/settings.json and the repo's
#              .claude/settings.json and .claude/settings.local.json; a missing
#              file is skipped.
# @option --superpowers-dir print the installed superpowers plugin's directory instead
# @arg $@ the rule strings, or `-` to read them one per line from stdin
# @stdout each requested rule no settings file allows, one per line, each
#         followed by `  covered by: <rule>` when a wider Bash rule covers it
# @stderr `defaultMode: <mode>` from the most specific file that sets it, or
#         `unset`; `bypassPermissions` and `auto` count only from the user
#         file, since a project or local file cannot turn them on
# @exitcode 0 success, whether or not a rule is missing
# @exitcode 1 --superpowers-dir found no installed superpowers plugin
# @exitcode 2 wrong arguments, CLAUDE_CONFIG_DIR unset, or a settings file is not valid JSON

# devshell-exempt: a work-backlog skill helper Claude Code runs on the host, outside any gate; it reads CLAUDE_CONFIG_DIR, which the devShell's cleared environment drops

set -Eeuo pipefail
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

# For a missing `Bash(<command>)` rule, the allowed `Bash(<prefix> *)` rule whose
# prefix is a whole-word prefix of the command, the longest one when several
# are; empty when none. Claude Code matches a rule by that prefix, so this is
# what makes a verbatim-missing rule still allowed.
# shellcheck disable=SC2016 # the $ names are jq variables, not shell ones
readonly COVERED_BY_JQ='
  ($rule | capture("^Bash\\((?<command>.*)\\)$").command) as $command # coverage-exempt: kcov scores this line; it never executes as bash
  | [.allow[] # coverage-exempt: kcov scores this line; it never executes as bash
     | select(test("^Bash\\(.* \\*\\)$")) # coverage-exempt: kcov scores this line; it never executes as bash
     | . as $wider # coverage-exempt: kcov scores this line; it never executes as bash
     | select($command | startswith(($wider | capture("^Bash\\((?<prefix>.*) \\*\\)$").prefix) + " "))] # coverage-exempt: kcov scores this line; it never executes as bash
  | max_by(length) // empty' # coverage-exempt: kcov scores this line; it never executes as bash

# @description Print the usage line to stderr and exit 2.
# @noargs
function usage() {
  printf 'usage: %s <rule>... | %s - | %s --superpowers-dir\n' "${0##*/}" "${0##*/}" "${0##*/}" >&2
  exit 2
}

# @description Print the settings files that exist, least specific first.
# @noargs
function settings_files() {
  # The main checkout's files, even from a worktree: a session may run this
  # from inside one, where the untracked settings.local.json is absent.
  local repo common_dir
  if common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2> /dev/null)"; then
    repo="$(dirname "${common_dir}")"
  else
    repo="$(pwd)"
  fi
  local file
  for file in \
    "${CLAUDE_CONFIG_DIR}/settings.json" \
    "${repo}/.claude/settings.json" \
    "${repo}/.claude/settings.local.json"; do
    if [[ -f "${file}" ]]; then
      printf '%s\n' "${file}"
    fi
  done
}

# @description Print the installed superpowers plugin's directory, as Claude
#              Code's plugin registry records it.
# @noargs
function superpowers_dir() {
  local -r registry="${CLAUDE_CONFIG_DIR}/plugins/installed_plugins.json"
  local dir=''
  if [[ -f "${registry}" ]]; then
    dir="$(jq --raw-output '
      [.plugins // {} | to_entries[] | select(.key | startswith("superpowers@")) | .value[].installPath]
      | first // empty' "${registry}")"
  fi
  if [[ -z "${dir}" || ! -d "${dir}" ]]; then
    printf '%s: no installed superpowers plugin in %s\n' "${0##*/}" "${registry}" >&2
    exit 1
  fi
  printf '%s\n' "${dir}"
}

# @description Print the requested rules no settings file allows, and the
#              effective defaultMode on stderr.
# @arg $@ the script's arguments
function main() {
  if (($# == 0)); then
    usage
  fi
  if [[ -z "${CLAUDE_CONFIG_DIR:-}" ]]; then
    printf '%s: CLAUDE_CONFIG_DIR is not set\n' "${0##*/}" >&2
    exit 2
  fi
  if [[ "$1" == '--superpowers-dir' ]]; then
    if (($# != 1)); then
      usage
    fi
    superpowers_dir
    return
  fi
  local -a rules=()
  if [[ "$1" == '-' ]]; then
    if (($# != 1)); then
      usage
    fi
    local line
    while IFS= read -r line || [[ -n "${line}" ]]; do
      if [[ -n "${line}" ]]; then
        rules+=("${line}")
      fi
    done
  else
    rules=("$@")
  fi
  local files
  files="$(settings_files)"
  local -a paths=()
  if [[ -n "${files}" ]]; then
    mapfile -t paths <<< "${files}"
  fi
  local merged='{"allow": [], "mode": "unset"}'
  local path
  for path in "${paths[@]}"; do
    # Claude Code ignores bypassPermissions and auto outside the user file.
    if ! merged="$(jq --argjson acc "${merged}" --arg user "${CLAUDE_CONFIG_DIR}/settings.json" --arg path "${path}" '
      (.permissions.defaultMode // null) as $mode
      | {allow: ($acc.allow + (.permissions.allow // [])),
         mode: (if $mode == null or ($path != $user and ($mode == "bypassPermissions" or $mode == "auto"))
                then $acc.mode else $mode end)}' "${path}" 2> /dev/null)"; then
      printf '%s: %s is not valid JSON\n' "${0##*/}" "${path}" >&2
      exit 2
    fi
  done
  printf 'defaultMode: %s\n' "$(jq --raw-output '.mode' <<< "${merged}")" >&2
  local rule
  local covered_by
  for rule in "${rules[@]}"; do
    if ! jq --exit-status --arg rule "${rule}" '.allow | index($rule) != null' <<< "${merged}" > /dev/null; then
      printf '%s\n' "${rule}"
      covered_by="$(jq --raw-output --arg rule "${rule}" "${COVERED_BY_JQ}" <<< "${merged}")"
      if [[ -n "${covered_by}" ]]; then
        printf '  covered by: %s\n' "${covered_by}"
      fi
    fi
  done
}

main "$@"
