#!/usr/bin/env bash

# @description Index the open backlog for choosing a chunk. Writes the full
#              issue JSON to a file and prints one TSV row per issue, so a
#              session classifies from a compact table and reads a full body
#              only for the issues it considers: the whole backlog's bodies run
#              far past what one tool result shows. A body over 16000 bytes is
#              also written on its own to issue-<N>.md beside the JSON, since
#              one tool result cuts it off too.
# @option --out <file> where to write the full JSON (default: .claude/tmp/issues.json
#         under the main checkout, so a run from a worktree still writes where
#         the session reads; under the working directory outside a git repo)
# @arg $@ issue numbers to index instead of every open issue
# @stdout a header line, then per issue: number, state (OPEN; a named issue
#         that is closed prints CLOSED, or MERGED when the number is in fact a
#         pull request's), kind (bug, feature or ? for a
#         judgment call), labels, title, repro (yes when the body says it
#         reproduces something, gives steps to, or reports a check failing on
#         main or an audit flagging the repo), refs (other issue numbers the
#         body names outside fenced code; with no issue named, only numbers
#         that are themselves open issues), umbrella (yes when the body calls
#         itself an umbrella or tracks sub-issues), comments (how many the
#         issue has; their bodies are in the JSON), bytes (body length),
#         pieces (how many merged pull requests hold the whole line
#         `Part of #<number>`, from one listing of every merged pull request
#         whose body says "Part of #")
# @exitcode 0 the index was written
# @exitcode 1 a gh call failed
# @exitcode 2 wrong arguments

set -Eeuo pipefail
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

readonly FIELDS='number,state,title,labels,body,comments'
# Every merged pull request that may be an earlier piece of some issue, listed
# once: the search phrase is quoted so GitHub matches it whole, and the row's
# count then checks the exact line, since the search also matches the words
# apart. The quotes are part of the argument, not shell quoting.
readonly PIECES_SEARCH='"Part of #" in:body'
# The Bash tool shows about this much of one result; a longer body is cut off.
readonly LONG_BODY_BYTES=16000

# The kind rules are the skill's: a `bug` label or a `fix:` title is a bug, a
# `feat:` title or an `enhancement` label is a feature, anything else is a
# judgment call the proposal names. The repro test wants a verb or a heading,
# not the stem alone: "reproducible" is a feature's word, not a bug's; a check
# that fails on main or an audit that flags the repo is a reproduction too. A
# `#N` inside fenced code is an example, not a reference, and with every open
# issue indexed ($all_open) a number that is not one of them is closed or a
# pull request, which the proposal's ordering must not read as a dependency.
# shellcheck disable=SC2016 # the $ names are jq variables, not shell ones
readonly TABLE_JQ='
  (map(.number)) as $indexed # coverage-exempt: kcov scores this line; it never executes as bash
  | ["number", "state", "kind", "labels", "title", "repro", "refs", "umbrella", "comments", "bytes", "pieces"], # coverage-exempt: kcov scores this line; it never executes as bash
  (sort_by(.number)[] # coverage-exempt: kcov scores this line; it never executes as bash
    | (.body // "") as $body # coverage-exempt: kcov scores this line; it never executes as bash
    | ([.labels[].name]) as $labels # coverage-exempt: kcov scores this line; it never executes as bash
    | .number as $self # coverage-exempt: kcov scores this line; it never executes as bash
    | [ # coverage-exempt: kcov scores this line; it never executes as bash
        .number, # coverage-exempt: kcov scores this line; it never executes as bash
        .state, # coverage-exempt: kcov scores this line; it never executes as bash
        (if ($labels | index("bug")) or (.title | test("^fix(\\([^)]*\\))?!?:")) then "bug" # coverage-exempt: kcov scores this line; it never executes as bash
         elif (.title | test("^feat(\\([^)]*\\))?!?:")) or ($labels | index("enhancement")) then "feature" # coverage-exempt: kcov scores this line; it never executes as bash
         else "?" end), # coverage-exempt: kcov scores this line; it never executes as bash
        ($labels | join(",")), # coverage-exempt: kcov scores this line; it never executes as bash
        .title, # coverage-exempt: kcov scores this line; it never executes as bash
        (if $body | test("reproduc(e|tion|es|ed)|steps to reproduce|repro:|flags (this|the) repo|fails on `?main`?"; "i") # coverage-exempt: kcov scores this line; it never executes as bash
         then "yes" else "" end), # coverage-exempt: kcov scores this line; it never executes as bash
        ([$body | gsub("```[\\s\\S]*?```"; "") | scan("(?<![#\\w])#([0-9]+)") | .[0] | tonumber # coverage-exempt: kcov scores this line; it never executes as bash
          | select(. != $self) | select(($all_open | not) or IN($indexed[]))] # coverage-exempt: kcov scores this line; it never executes as bash
          | unique | map(tostring) | join(",")), # coverage-exempt: kcov scores this line; it never executes as bash
        (if ($body | test("- \\[[ xX]\\] [^\\n]*#[0-9]+")) or ($body | test("sub-issue|umbrella"; "i")) # coverage-exempt: kcov scores this line; it never executes as bash
         then "yes" else "" end), # coverage-exempt: kcov scores this line; it never executes as bash
        (.comments // [] | length), # coverage-exempt: kcov scores this line; it never executes as bash
        ($body | utf8bytelength), # coverage-exempt: kcov scores this line; it never executes as bash
        ([$pieces[] | select((.body // "") | test("(^|\\n)Part of #" + ($self | tostring) + "(\\n|$)"))] | length) # coverage-exempt: kcov scores this line; it never executes as bash
      ]) # coverage-exempt: kcov scores this line; it never executes as bash
  | @tsv' # coverage-exempt: kcov scores this line; it never executes as bash

# @description Print the usage line to stderr and exit 2.
# @noargs
function usage() {
  printf 'usage: %s [--out <file>] [<issue>...]\n' "${0##*/}" >&2
  exit 2
}

# @description Print the JSON array of the named issues, or of every open issue.
# @arg $@ issue numbers, none for every open issue
function fetch() {
  if (($# == 0)); then
    gh issue list --state open --limit 1000 --json "${FIELDS}"
    return
  fi
  local issue
  for issue in "$@"; do
    gh issue view "${issue}" --json "${FIELDS}" || return 1
  done | jq --slurp '.'
}

# @description Print the JSON array of the merged pull requests whose body says
#              "Part of #", the candidates for an issue's earlier pieces.
# @noargs
function fetch_pieces() {
  gh pr list --state merged --limit 1000 --search "${PIECES_SEARCH}" --json number,body
}

# @description Print the default index path: .claude/tmp/issues.json under the
#              main checkout (the parent of the git common dir, so a worktree
#              resolves to the checkout the session reads from), or under the
#              working directory outside a git repo.
# @noargs
function default_out() {
  local common_dir
  if common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2> /dev/null)"; then
    printf '%s/.claude/tmp/issues.json\n' "$(dirname "${common_dir}")"
  else
    printf '.claude/tmp/issues.json\n'
  fi
}

# @description Write each body longer than LONG_BODY_BYTES to issue-<N>.md in
#              the index's directory, for the Read tool to page.
# @arg $1 json the index file
function write_long_bodies() {
  local -r json="$1"
  local -r dir="$(dirname "${json}")"
  # shellcheck disable=SC2016 # the $ name is a jq variable, not a shell one
  local -r long_numbers='.[] | select((.body // "") | utf8bytelength > $max) | .number'
  local number
  while IFS= read -r number; do
    jq --raw-output --argjson n "${number}" '.[] | select(.number == $n) | .body' "${json}" \
      > "${dir}/issue-${number}.md"
  done < <(jq --raw-output --argjson max "${LONG_BODY_BYTES}" "${long_numbers}" "${json}") # coverage-exempt: kcov scores this line; it never executes as bash
}

# @description Parse the arguments, write the JSON and print the table.
# @arg $@ the script's arguments
function main() {
  local out=''
  local -a issues=()
  while (($# > 0)); do
    case "$1" in
      --out)
        if (($# < 2)) || [[ -z "$2" ]]; then
          usage
        fi
        out="$2"
        shift 2
        ;;
      *)
        if [[ ! "$1" =~ ^[1-9][0-9]*$ ]]; then
          usage
        fi
        issues+=("$1")
        shift
        ;;
    esac
  done
  if [[ -z "${out}" ]]; then
    out="$(default_out)"
  fi
  local json
  if ! json="$(fetch "${issues[@]}")"; then
    printf '%s: gh failed to list the issues\n' "${0##*/}" >&2
    exit 1
  fi
  local pieces
  if ! pieces="$(fetch_pieces)"; then
    printf '%s: gh failed to list the merged pull requests\n' "${0##*/}" >&2
    exit 1
  fi
  mkdir --parents "$(dirname "${out}")"
  printf '%s\n' "${json}" > "${out}"
  write_long_bodies "${out}"
  local all_open='false'
  if ((${#issues[@]} == 0)); then
    all_open='true'
  fi
  jq --raw-output --argjson all_open "${all_open}" --argjson pieces "${pieces}" "${TABLE_JQ}" "${out}"
}

main "$@"
