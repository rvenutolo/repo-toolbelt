#!/usr/bin/env bash

# @description Check every prerequisite a backlog session needs before the
#              user's sitting starts, so a missing one costs one line here
#              instead of a failed step hours later. Each check prints one
#              line, PASS, WARN or FAIL, in a fixed order; a FAIL is something
#              the session cannot work around, a WARN something the proposal
#              should mention. Read-only apart from `git fetch origin main`.
# @noargs
# @stdout one `PASS|WARN|FAIL <check>: <detail>` line per check, in order:
#         config-dir, gh-auth, clean-tree, on-main, main-current, signing,
#         agent-key, ip-forward, superpowers, config (one WARN per ignored line,
#         then its PASS), notification-hook, state; then
#         `preflight: <n> fail, <m> warn`
# @exitcode 0 no check failed
# @exitcode 1 a check failed
# @exitcode 2 wrong arguments, CLAUDE_CONFIG_DIR unset, or not inside a git repository

# devshell-exempt: a work-backlog skill helper Claude Code runs on the host, outside any gate; it reads CLAUDE_CONFIG_DIR and checks the host's gh login, signing and IP forwarding, which the devShell's cleared environment would hide

set -Eeuo pipefail
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

# The helper scripts and the overrides file live beside this script, so a
# fixture repo without them still runs the checks that need them.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly PERMISSION_DIFF="${SCRIPT_DIR}/permission-diff"
readonly OVERRIDES="${SCRIPT_DIR}/sub-skill-overrides.md"
readonly CONTAINER_STEP='./.ci/test-image'
readonly LIFETIME_NOTE='lifetime cannot be read; confirm the key was added with no lifetime that ends during the run'
# One line, since the detail is printed on the check's own line.
HOOK_EXAMPLE='{"hooks":{"Notification":[{"hooks":[{"type":"command",'
# shellcheck disable=SC2016 # the $(...) is part of the example hook command, not something to expand here
HOOK_EXAMPLE+='"command":"notify-send Claude \"$(jq --raw-output .message)\""}]}]}}'
readonly HOOK_EXAMPLE

FAILS=0
WARNS=0
MAIN=''

# @description Print the usage line to stderr and exit 2.
# @noargs
function usage() {
  printf 'usage: %s\n' "${0##*/}" >&2
  exit 2
}

# @description Print one check line and count it.
# @arg $1 status PASS, WARN or FAIL
# @arg $2 check the check name
# @arg $3 detail what was found
function report() {
  local -r status="$1"
  local -r check="$2"
  local -r detail="$3"
  printf '%s %s: %s\n' "${status}" "${check}" "${detail}"
  case "${status}" in
    FAIL) FAILS=$((FAILS + 1)) ;;
    WARN) WARNS=$((WARNS + 1)) ;;
    *) ;; # coverage-exempt: an empty case arm; bash runs nothing on it for kcov to see
  esac
}

# @description CLAUDE_CONFIG_DIR names a directory.
# @noargs
function check_config_dir() {
  if [[ -d "${CLAUDE_CONFIG_DIR}" ]]; then
    report PASS config-dir "${CLAUDE_CONFIG_DIR}"
  else
    report FAIL config-dir "${CLAUDE_CONFIG_DIR} is not a directory"
  fi
}

# @description gh is logged in to github.com.
# @noargs
function check_gh_auth() {
  if gh auth status --hostname github.com > /dev/null 2>&1; then
    report PASS gh-auth 'github.com'
  else
    report FAIL gh-auth 'gh auth status --hostname github.com failed; run gh auth login'
  fi
}

# @description The working tree has no change git would report.
# @noargs
function check_clean_tree() {
  local count
  count="$(git status --porcelain | wc --lines)"
  if ((count == 0)); then
    report PASS clean-tree 'no changes'
  else
    report FAIL clean-tree "${count} changed path(s); commit or stash them"
  fi
}

# @description main is checked out.
# @noargs
function check_on_main() {
  local branch
  if ! branch="$(git symbolic-ref --quiet --short HEAD)"; then
    report FAIL on-main 'detached HEAD; git switch main'
  elif [[ "${branch}" == 'main' ]]; then
    report PASS on-main 'main'
  else
    report FAIL on-main "on ${branch}; git switch main"
  fi
}

# @description Local main holds no commit origin/main lacks, after a fetch.
# @noargs
function check_main_current() {
  if ! git fetch --quiet origin main > /dev/null 2>&1; then
    report FAIL main-current 'git fetch origin main failed'
  elif git merge-base --is-ancestor HEAD origin/main; then
    report PASS main-current 'main is at or behind origin/main'
  else
    report FAIL main-current 'local main has a commit origin/main lacks; move it off main'
  fi
}

# @description Print the configured signing key path, or nothing.
# @noargs
function signing_key() {
  git config --get user.signingkey 2> /dev/null || true
}

# @description ssh signing is configured and the key signs a test message.
# @noargs
function check_signing() {
  local format key
  format="$(git config --get gpg.format 2> /dev/null || true)"
  key="$(signing_key)"
  if [[ "${format}" != 'ssh' ]]; then
    report FAIL signing "gpg.format is ${format:-unset}, not ssh"
  elif [[ -z "${key}" || ! -r "${key}" ]]; then
    report FAIL signing "user.signingkey ${key:-unset} is not a readable file"
  elif printf 'x' | ssh-keygen -Y sign -n git -f "${key}" > /dev/null 2>&1; then
    report PASS signing "ssh key ${key} signs"
  else
    report FAIL signing "test signature failed with ${key}; the key is not usable"
  fi
}

# @description The agent lists the key's public half. Its lifetime cannot be
#              read, so the check is always a WARN asking the user to confirm
#              it, which carries it into the proposal.
# @noargs
function check_agent_key() {
  local key pub listed public_key
  key="$(signing_key)"
  pub="${key}"
  if [[ "${pub}" != *.pub ]]; then
    pub="${key}.pub"
  fi
  if [[ -z "${key}" || ! -r "${pub}" ]]; then
    report WARN agent-key "no public key beside ${key:-the signing key}; ${LIFETIME_NOTE}"
    return
  fi
  if ! listed="$(ssh-add -L 2> /dev/null)"; then
    report WARN agent-key "ssh-add -L failed, so no agent holds the key; ${LIFETIME_NOTE}"
    return
  fi
  # The first two fields identify a key; the comment after them may differ.
  public_key="$(cut --delimiter=' ' --fields=1,2 "${pub}")"
  listed="$(cut --delimiter=' ' --fields=1,2 <<< "${listed}")"
  if [[ -n "${public_key}" ]] && grep --quiet --fixed-strings --line-regexp "${public_key}" <<< "${listed}"; then
    report WARN agent-key "listed by ssh-add -L; ${LIFETIME_NOTE}"
  else
    report WARN agent-key "not listed by ssh-add -L; ${LIFETIME_NOTE}"
  fi
}

# @description IP forwarding is on, which only the image test needs.
# @noargs
function check_ip_forward() {
  local value
  value="$(sysctl --values net.ipv4.ip_forward 2> /dev/null || true)"
  if [[ "${value}" == '1' ]]; then
    report PASS ip-forward '1'
  else
    report WARN ip-forward "net.ipv4.ip_forward is ${value:-unreadable}; needed only by ${CONTAINER_STEP}"
  fi
}

# @description The superpowers plugin is installed at the version the
#              overrides quote.
# @noargs
function check_superpowers() {
  local dir installed quoted
  if ! dir="$("${PERMISSION_DIFF}" --superpowers-dir 2> /dev/null)"; then
    report FAIL superpowers 'no installed superpowers plugin'
    return
  fi
  installed="${dir##*/}"
  quoted="$(grep --only-matching --extended-regexp --max-count=1 'superpowers [0-9]+\.[0-9]+\.[0-9]+' "${OVERRIDES}" || true)"
  quoted="${quoted#superpowers }"
  if [[ "${installed}" == "${quoted}" ]]; then
    report PASS superpowers "${installed} installed and quoted"
  else
    report WARN superpowers "installed ${installed}, sub-skill-overrides.md quotes ${quoted:-no version}"
  fi
}

# @description Every line of .claude/backlog/config is a known key with a
#              valid value, a comment or blank. A bad line is a WARN, never a
#              FAIL: the session reads the default in its place.
# @noargs
function check_config() {
  local -r file="${MAIN}/.claude/backlog/config"
  if [[ ! -f "${file}" ]]; then
    report PASS config 'defaults'
    return
  fi
  local line key value valid n=0 keys=0
  while IFS= read -r line || [[ -n "${line}" ]]; do
    n=$((n + 1))
    if [[ -z "${line}" || "${line}" == '#'* ]]; then
      continue
    fi
    key="${line%%: *}"
    value="${line#*: }"
    valid='false'
    case "${key}" in
      shakedown | shakedown-parallel)
        if [[ "${value}" == 'on' || "${value}" == 'off' ]]; then
          valid='true'
        fi
        ;;
      max-hours | max-parked)
        if [[ "${value}" =~ ^[1-9][0-9]*$ ]]; then
          valid='true'
        fi
        ;;
      *) ;; # coverage-exempt: an empty case arm; bash runs nothing on it for kcov to see
    esac
    if [[ "${valid}" != 'true' || "${line}" != "${key}: ${value}" ]]; then
      report WARN config \
        "line ${n} \"${line}\" ignored; default used (keys: shakedown|shakedown-parallel|max-hours|max-parked)"
      continue
    fi
    keys=$((keys + 1))
  done < "${file}" # coverage-exempt: kcov scores a loop's redirect line, which bash never runs on its own
  report PASS config "${keys} keys"
}

# @description Some settings file has a Notification hook, so a halt reaches
#              the user's desktop while the session waits.
# @noargs
function check_notification_hook() {
  local file
  for file in "${CLAUDE_CONFIG_DIR}/settings.json" "${MAIN}/.claude/settings.json" \
    "${MAIN}/.claude/settings.local.json"; do
    if [[ -f "${file}" ]] && jq --exit-status '.hooks.Notification | length > 0' "${file}" > /dev/null 2>&1; then
      report PASS notification-hook "${file}"
      return
    fi
  done
  report WARN notification-hook "none set; a hook such as ${HOOK_EXAMPLE} in settings.json shows a halt on the desktop"
}

# @description What .claude/backlog/ holds, for the reader; never a failure.
# @noargs
function check_state() {
  local -r dir="${MAIN}/.claude/backlog"
  local record='absent' parallel=0 findings=0 noun='files'
  if [[ -f "${dir}/current-session.md" ]]; then
    record='present'
  fi
  if [[ -d "${dir}/parallel" ]]; then
    parallel="$(find "${dir}/parallel" -mindepth 1 -maxdepth 1 -type f | wc --lines)"
  fi
  if ((parallel == 1)); then
    noun='file'
  fi
  if [[ -f "${dir}/pending-findings.md" ]]; then
    findings="$(grep --count '^## ' "${dir}/pending-findings.md" || true)"
  fi
  report PASS state "current-session.md ${record}; parallel: ${parallel} ${noun}; pending findings: ${findings}"
}

# @description Run every check in order and print the count.
# @noargs
function main() {
  local common_dir
  if ! common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2> /dev/null)"; then
    printf '%s: not inside a git repository\n' "${0##*/}" >&2
    exit 2
  fi
  MAIN="$(dirname "${common_dir}")"
  check_config_dir
  check_gh_auth
  check_clean_tree
  check_on_main
  check_main_current
  check_signing
  check_agent_key
  check_ip_forward
  check_superpowers
  check_config
  check_notification_hook
  check_state
  printf 'preflight: %s fail, %s warn\n' "${FAILS}" "${WARNS}"
  if ((FAILS > 0)); then
    exit 1
  fi
}

if (($# != 0)); then
  usage
fi
if [[ -z "${CLAUDE_CONFIG_DIR:-}" ]]; then
  printf '%s: CLAUDE_CONFIG_DIR is not set\n' "${0##*/}" >&2
  exit 2
fi
main
