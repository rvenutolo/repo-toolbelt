#!/usr/bin/env bash

# @description Wait for a regular file to exist with content, for at most a given number of seconds.
#              Workflow agents use it to wait on a background command that
#              writes its exit status to a file. With a hang limit, the first wait writes its time to
#              `<file>.start` and later waits keep it, so a command is judged
#              hung by the time since it started, not by how many waits ran:
#              the Bash tool may cut a wait short, which makes a count wrong.
# @arg $1 file path of the file to wait for
# @arg $2 seconds how long to wait, a positive whole number
# @arg $3 hang-seconds optional; how long after the start time a missing status means a hang
# @exitcode 0 the file exists, is a regular file and is not empty
# @exitcode 1 with a hang limit, `<file>.start` could not be written, as when the file's directory does not exist
# @exitcode 2 wrong arguments, the path exists and is not a regular file, or `<file>.start` holds no whole number or
#              was written at least twice the hang limit ago, so it belongs to a dead caller's command
# @exitcode 3 the hang limit has passed since the start time and the file is still missing or empty
# @exitcode 124 the file did not appear in time, the code `timeout` uses

# devshell-exempt: a work-backlog-parallel skill helper workflow agents run on the host by its path, outside any gate; it needs only bash and sleep

set -Eeuo pipefail
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

readonly POLL_SECONDS=5

# @description Print the usage line to stderr and exit 2.
# @noargs
function usage() {
  printf 'usage: %s <file> <seconds> [<hang-seconds>]\n' "${0##*/}" >&2
  exit 2
}

# @description Poll for the file until it exists with content or the time runs out.
# @arg $1 file path of the file to wait for
# @arg $2 seconds how long to wait
# @arg $3 hang-seconds optional hang limit, counted from the time in `<file>.start`
function main() {
  if (($# < 2 || $# > 3)); then
    usage
  fi
  local -r file="$1"
  local -r seconds="$2"
  local -r hang="${3:-}"
  if [[ -z "${file}" || ! "${seconds}" =~ ^[0-9]+$ ]] || ((10#${seconds} == 0)); then
    usage
  fi
  if (($# == 3)) && { [[ ! "${hang}" =~ ^[0-9]+$ ]] || ((10#${hang} == 0)); }; then
    usage
  fi
  # A status file is always a regular file. Anything else at the path (a
  # directory, which `-s` alone accepts) is a wrong path that no write will fix.
  if [[ -e "${file}" && ! -f "${file}" ]]; then
    usage
  fi
  local hung_at=''
  if [[ -n "${hang}" ]]; then
    local -r start_file="${file}.start"
    local inherited=1
    if [[ ! -e "${start_file}" ]]; then
      printf '%s\n' "${EPOCHSECONDS}" > "${start_file}"
      inherited=0
    fi
    local start
    start="$(< "${start_file}")"
    if [[ ! "${start}" =~ ^[0-9]+$ ]]; then
      usage
    fi
    # A wait at or past the hang limit exits 3 at once and its caller acts on
    # that, so no live command is still waited on twice the limit after its
    # start: a start file that old belongs to a dead caller's command.
    if ((inherited && EPOCHSECONDS - 10#${start} >= 2 * 10#${hang})); then
      printf '%s: stale start file %s; use a new status name\n' "${0##*/}" "${start_file}" >&2
      exit 2
    fi
    hung_at="$((10#${start} + 10#${hang}))"
  fi
  local -r deadline="$((SECONDS + 10#${seconds}))"
  while [[ ! -f "${file}" || ! -s "${file}" ]]; do
    if [[ -n "${hung_at}" ]] && ((EPOCHSECONDS >= hung_at)); then
      exit 3
    fi
    if ((SECONDS >= deadline)); then
      exit 124
    fi
    sleep "${POLL_SECONDS}"
  done
}

main "$@"
