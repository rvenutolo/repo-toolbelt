#!/usr/bin/env bash

# @description Assert that every GitHub Actions step which runs a command runs
#              it inside the repo's hermetic Nix devShell wrapper. Reads its
#              exemptions and wrapper path from its section of
#              `.repo-toolbelt.yml`, which the runner hands it as JSON in the
#              file TOOLBELT_SECTION names, and fails on any error in that
#              section before scanning anything. Scans every `*.yml`
#              and `*.yaml` file under `.github/workflows` and `.github/actions`,
#              recursively, following symlinks.
#
#              Rule 1: every step carrying a `run:` key names the wrapper in its
#              run body, or is exempted. A step that shells out on the bare
#              runner resolves its tools from whatever the runner image ships,
#              which is the ambient-dependency drift the boundary exists to
#              prevent. The check is a substring test on the whole body: a
#              per-command rule would need a quote-aware split, or the inner
#              script of `<wrapper> bash -c '...'` would read as unwrapped
#              commands. Rule 2 closes the gap that leaves.
#
#              Rule 2: no scanned file enters the devShell directly. That belongs
#              to the wrapper alone, because the wrapper supplies the cleared
#              environment and its allowlist; a direct entry looks correct while
#              being no boundary at all.
#
#              Exemptions are keyed `<repo-relative-file>::<step-id>`, and
#              staleness is checked both ways: an exemption naming no run step,
#              or naming only steps that already use the wrapper, is a
#              violation. A non-compliant step with no `id:` is reported with
#              the fix, because its `name:` is free text and drifts.
# @arg $1 --help print usage and exit
# @stdout the usage line, with --help; otherwise one line per config error,
#         then `<N> .repo-toolbelt.yml error(s)`, or one line per violation or
#         stale exemption, then `<N> hermetic-boundary violation(s)`
# @stderr one line naming a setup failure
# @exitcode 0 the config is valid and no violation was found
# @exitcode 1 a config error, a violation or a stale exemption
# @exitcode 2 a setup failure: an unexpected argument, TOOLBELT_SECTION unset
#             or naming no file, a scan root that cannot be listed, not inside
#             a git repository, or an internal failure

set -Eeuo pipefail
IFS=$'\n\t'

# An unexpected failure is a crash, not a finding, so it exits with the
# setup-failure status rather than errexit's status of the failed command.
trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2; exit 2' ERR

# bash 4.4 for `inherit_errexit`, namerefs and associative arrays; the image
# runs the script under the nixpkgs bash, which satisfies this.
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
  printf '%s: bash 4.4+ required (found %s.%s)\n' "${0##*/}" "${BASH_VERSINFO[0]}" "${BASH_VERSINFO[1]}" >&2
  exit 2
fi

# Found relative to this script's resolved path, never through the environment,
# so the source tree and the image share one layout.
# shellcheck source=lib/toolbelt.bash
source "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/../../lib/toolbelt.bash"

# Without this, errexit is off inside every $(...) subshell, so a helper called
# as `n="$(scan ...)"` runs past a failed command and the lint exits 0.
shopt -s inherit_errexit

readonly LINT='check-workflow-hermetic'
readonly DEFAULT_WRAPPER='.ci/in-devshell'
readonly USAGE="usage: ${LINT} [--help]"

# The exempt steps, filled by main once the config is valid. Script-level so
# scan_file can test membership without passing an associative array around.
declare -A EXEMPT_STEPS=()

# The directories scanned, relative to the repo root. Exemption keys start
# with these.
readonly SCAN_ROOTS=('.github/workflows' '.github/actions')

# The forbidden direct-entry spelling is assembled from two words, and matched
# as a regex with a class where its space would be, so this source never
# contains the string it forbids: the user's repos scan their trees for it. The
# class also tolerates runs of whitespace, newlines included, and a backslash
# before whitespace, so a shell line continuation counts as a space. The outer
# classes are word boundaries, so `in-devshell` and `nix-installer-action` do
# not match. The pattern is valid both as a grep ERE and as a Go regexp for yq.
readonly NIX_WORD='nix'
readonly DEVELOP_WORD='develop'
readonly FORBIDDEN_SPELLING="${NIX_WORD} ${DEVELOP_WORD}"
readonly FORBIDDEN_GAP='([[:space:]]|\\[[:space:]])+'
readonly FORBIDDEN_PATTERN="(^|[^[:alnum:]_-])${NIX_WORD}${FORBIDDEN_GAP}${DEVELOP_WORD}([^[:alnum:]_-]|\$)"

# yq expression counting, per document, the scalar values whose decoded text
# matches TOOLBELT_FORBIDDEN_PATTERN. The raw-text grep misses a spelling
# split by plain-scalar line folding or written with an escape such as `\x20`;
# the decoded value shows both.
readonly DIRECT_SCALARS_EXPR='[.. | select(kind == "scalar") | tostring
  | select(test(strenv(TOOLBELT_FORBIDDEN_PATTERN)))] | length' # coverage-exempt: kcov scores this line; it never executes as bash

# yq expression listing every duplicate mapping key anywhere in a document. A
# duplicated `jobs` or `run` would otherwise hide the first value from every
# later read.
readonly WORKFLOW_DUPLICATE_KEYS_EXPR='.. | '"${TOOLBELT_DUPLICATE_KEYS_FRAGMENT}"

# yq expression emitting one record per step that carries a `run:` key, for
# both the workflow (`.jobs[].steps[]`) and composite-action (`.runs.steps[]`)
# shapes. Structural guards test `kind`, not `type`: `type` is the node's tag,
# so a tagged map or list would read as neither and its steps would vanish.
# The record is built by concatenation, not `[...] | join`: on an empty
# stream yq still builds the array and prints an empty line. explode(.)
# resolves aliases and merge keys first, so a step, steps list or run body
# reached through one is still seen; the caller runs yq with merge keys
# resolved to the YAML spec, where a local key beats a merged one.
# A record is `job|index|id|id_unsafe|name|compliant`: job, index, id and name
# are base64, so a `|` or newline in them cannot break the record apart, and an
# absent id or name encodes as empty. id_unsafe is true when the id holds a
# control character, which no exemption can name. compliant is true only for a
# plain string body containing TOOLBELT_WRAPPER, tested here on the real
# string: a NUL in the body cannot vanish the way it would in bash.
# shellcheck disable=SC2016 # $job is a yq variable, not a shell one
readonly EXTRACT_RUN_STEPS_EXPR='
explode(.) | select(kind == "map") # coverage-exempt: kcov scores this line; it never executes as bash
| [ # coverage-exempt: kcov scores this line; it never executes as bash
    (.jobs | select(kind == "map" or kind == "seq") | to_entries | .[] | .key as $job # coverage-exempt: kcov scores this line; it never executes as bash
      | .value | select(kind == "map") | .steps | select(kind == "seq" or kind == "map") # coverage-exempt: kcov scores this line; it never executes as bash
      | to_entries | .[] | {"j": ($job | tostring), "i": (.key | tostring), "v": .value}), # coverage-exempt: kcov scores this line; it never executes as bash
    (.runs | select(kind == "map") | .steps | select(kind == "seq" or kind == "map") # coverage-exempt: kcov scores this line; it never executes as bash
      | to_entries | .[] | {"j": "runs", "i": (.key | tostring), "v": .value}) # coverage-exempt: kcov scores this line; it never executes as bash
  ] # coverage-exempt: kcov scores this line; it never executes as bash
| .[] # coverage-exempt: kcov scores this line; it never executes as bash
| select(.v | kind == "map") # coverage-exempt: kcov scores this line; it never executes as bash
| select(.v | has("run")) # coverage-exempt: kcov scores this line; it never executes as bash
| ((.v.id // "") | tostring) as $id # coverage-exempt: kcov scores this line; it never executes as bash
| (.j | @base64) # coverage-exempt: kcov scores this line; it never executes as bash
  + "|" + (.i | @base64) # coverage-exempt: kcov scores this line; it never executes as bash
  + "|" + ($id | @base64) # coverage-exempt: kcov scores this line; it never executes as bash
  + "|" + ($id | test("[[:cntrl:]]") | tostring) # coverage-exempt: kcov scores this line; it never executes as bash
  + "|" + ((.v.name // "") | tostring | @base64) # coverage-exempt: kcov scores this line; it never executes as bash
  + "|" + (((.v.run | select(tag == "!!str") | contains(strenv(TOOLBELT_WRAPPER))) // false) | tostring) # coverage-exempt: kcov scores this line; it never executes as bash
' # coverage-exempt: kcov scores this line; it never executes as bash

# The validators return their error count, so callers test their status and
# errexit is off inside them. Every helper below therefore checks each command
# itself and dies on failure, and none runs inside a command substitution,
# where a die would exit only the subshell.

# @description Print one error in this lint's section of the config file.
# @arg $1 problem the problem, without the section prefix
# @stdout `.repo-toolbelt.yml: check-workflow-hermetic: <problem>`
function section_error() {
  local -r problem="$1"
  toolbelt::section_error "${LINT}" "${problem}"
}

# @description Evaluate a yq expression over the section JSON file and store
#              the result, as a raw scalar or YAML, in the named variable. The
#              value is kept exactly, trailing newlines included.
# @global QUERY_FILE scratch file that receives yq's output
# @global YQ_ERR_FILE file that receives yq's stderr
# @arg $1 result_var name of the variable to set
# @arg $2 json_file the section JSON
# @arg $3 expr the yq expression
function json_query() {
  local -n result_ref="$1"
  local -r json_file="$2"
  local -r expr="$3"
  toolbelt::yq "${QUERY_FILE}" "${YQ_ERR_FILE}" --input-format=json --output-format=yaml "${expr}" "${json_file}"
  toolbelt::require_file "${QUERY_FILE}"
  # Not `$(< file)`, which strips every trailing newline and would let
  # `step: "a.yml::x\n"` through. read -d '' always reports end of input as
  # status 1, so that status says nothing.
  IFS= read -r -d '' result_ref < "${QUERY_FILE}" || true
  # yq ends its output with exactly one newline of its own.
  result_ref="${result_ref%$'\n'}"
}

# @description Report every key of a map in this lint's section that is not
#              allowed. The runner has already rejected merge keys, and reading
#              JSON, yq takes a `<<` key as a plain key, so a quoted one is
#              reported like any other. The comparison runs inside yq and keys
#              print escaped, so a key holding a newline can neither split into
#              allowed names nor break a message line.
# @global YQ_ERR_FILE file that receives yq's stderr
# @arg $1 section_file the section JSON
# @arg $2 map_path yq path of the map, such as `.exempt[0]`, or `.` for the
#         section itself
# @arg $3 prefix what to put before `unknown key '<k>'`
# @arg $4 allowed the allowed keys, comma-separated
# @arg $5 scratch_file a file to use as scratch space
# @stdout one section error per unknown key
# @exitcode * the number of unknown keys, capped at 255
function report_unknown_keys() {
  local -r section_file="$1"
  local -r map_path="$2"
  local -r prefix="$3"
  local -r allowed="$4"
  local -r scratch_file="$5"
  TOOLBELT_ALLOWED="${allowed}" toolbelt::yq "${scratch_file}" "${YQ_ERR_FILE}" \
    --input-format=json --output-format=yaml "${map_path} | ${TOOLBELT_UNKNOWN_KEYS_EXPR}" "${section_file}"
  toolbelt::require_file "${scratch_file}"
  local errors=0 key
  while IFS= read -r key; do
    section_error "${prefix}unknown key '${key}'"
    errors=$((errors + 1))
  done < "${scratch_file}" # coverage-exempt: kcov scores this line; it never executes as bash
  toolbelt::return_count "${errors}"
}

# @description Validate one `exempt` entry and write its step to out_step_file
#              when the step is well-formed. Duplicates are the caller's check.
# @arg $1 section_file the section JSON
# @arg $2 index the entry's zero-based index
# @arg $3 out_step_file where to write the step; left empty when it is invalid
# @stdout one section error per problem
# @exitcode * the number of problems, capped at 255
function validate_entry() {
  local -r section_file="$1"
  local -r index="$2"
  local -r out_step_file="$3"
  local -r entry=".exempt[${index}]"
  local -r where="exempt[${index}]"
  local errors=0 count=0

  : > "${out_step_file}" || toolbelt::die "cannot write ${out_step_file}"

  local entry_type
  json_query entry_type "${section_file}" "${entry} | type"
  if [[ "${entry_type}" != '!!map' ]]; then
    section_error "${where} must be a map"
    return 1
  fi

  report_unknown_keys "${section_file}" "${entry}" "${where}: " 'step,reason' "${out_step_file}" || count=$?
  errors=$((errors + count))
  : > "${out_step_file}" || toolbelt::die "cannot write ${out_step_file}"

  local step_type step='' step_ok=0
  json_query step_type "${section_file}" "${entry}.step | type"
  case "${step_type}" in
    '!!null')
      section_error "${where}: step is missing"
      errors=$((errors + 1))
      ;;
    '!!str')
      json_query step "${section_file}" "${entry}.step"
      # Exactly one `::`: splitting at the first and at the last occurrence
      # must agree, which also rejects an overlapping `:::`. Neither part may
      # be blank. A control character never appears in a real step key, and a
      # newline would split the one-step-per-line exempt file.
      local -r file_part="${step%%::*}"
      local -r id_part="${step#*::}"
      if [[ "${step}" == *::* && "${file_part}" == "${step%::*}" && -n "${file_part//[[:space:]]/}" &&
        -n "${id_part//[[:space:]]/}" && "${step}" != *[[:cntrl:]]* ]]; then
        step_ok=1
      else
        local shown_step
        toolbelt::printable shown_step "${step}"
        section_error "${where}: step '${shown_step}' is not <file>::<id>"
        errors=$((errors + 1))
      fi
      ;;
    *)
      section_error "${where}: step must be a string"
      errors=$((errors + 1))
      ;;
  esac

  local reason_type reason
  json_query reason_type "${section_file}" "${entry}.reason | type"
  case "${reason_type}" in
    '!!null')
      section_error "${where}: reason is missing or empty"
      errors=$((errors + 1))
      ;;
    '!!str')
      json_query reason "${section_file}" "${entry}.reason"
      if [[ -z "${reason//[[:space:]]/}" ]]; then
        section_error "${where}: reason is missing or empty"
        errors=$((errors + 1))
      fi
      ;;
    *)
      section_error "${where}: reason must be a string"
      errors=$((errors + 1))
      ;;
  esac

  if ((step_ok == 1)); then
    printf '%s\n' "${step}" > "${out_step_file}" || toolbelt::die "cannot write ${out_step_file}"
  fi
  toolbelt::return_count "${errors}"
}

# @description Validate this lint's section of `.repo-toolbelt.yml`, as the
#              runner writes it, and extract its settings.
# @global TMP_DIR the scratch directory
# @arg $1 section_json_file the section as JSON; `null` means no section
# @arg $2 out_exempt_file where to write each valid exempt step, one per line
# @arg $3 out_wrapper_var name of the variable to set to the wrapper path
# @stdout one `.repo-toolbelt.yml: check-workflow-hermetic: <problem>` line per problem
# @exitcode 0 the section is valid
# @exitcode * the number of problems, capped at 255
function validate_section() {
  local -r section_json_file="$1"
  local -r out_exempt_file="$2"
  local -n wrapper_ref="$3"
  local -r scratch_file="${TMP_DIR}/section-scratch"
  local errors=0 count=0

  wrapper_ref="${DEFAULT_WRAPPER}"
  : > "${out_exempt_file}" || toolbelt::die "cannot write ${out_exempt_file}"

  local section_type
  json_query section_type "${section_json_file}" 'type'
  case "${section_type}" in
    '!!null') return 0 ;;
    '!!map') ;; # coverage-exempt: kcov scores this line; it never executes as bash
    *)
      toolbelt::config_error "${LINT} must be a map"
      return 1
      ;;
  esac

  report_unknown_keys "${section_json_file}" '.' '' 'wrapper,exempt' "${scratch_file}" || count=$?
  errors=$((errors + count))

  # A key given with no value is null. It counts as the wrong type, not as
  # absent, so a half-written setting is reported instead of ignored.
  local has_wrapper wrapper_type wrapper_value
  json_query has_wrapper "${section_json_file}" 'has("wrapper")'
  if [[ "${has_wrapper}" == 'true' ]]; then
    json_query wrapper_type "${section_json_file}" '.wrapper | type'
    if [[ "${wrapper_type}" == '!!str' ]]; then
      json_query wrapper_value "${section_json_file}" '.wrapper'
      # An empty wrapper would be found in every run body and exempt them all.
      if [[ -z "${wrapper_value//[[:space:]]/}" ]]; then
        section_error 'wrapper must not be empty'
        errors=$((errors + 1))
      elif [[ "${wrapper_value}" == *$'\n'* ]]; then
        section_error 'wrapper must be a single line'
        errors=$((errors + 1))
      else
        # shellcheck disable=SC2034 # set through the nameref; the caller reads it
        wrapper_ref="${wrapper_value}"
      fi
    else
      section_error 'wrapper must be a string'
      errors=$((errors + 1))
    fi
  fi

  local has_exempt exempt_type
  json_query has_exempt "${section_json_file}" 'has("exempt")'
  if [[ "${has_exempt}" == 'true' ]]; then
    json_query exempt_type "${section_json_file}" '.exempt | type'
    if [[ "${exempt_type}" == '!!seq' ]]; then
      local entry_count index step
      local -A seen_steps=()
      json_query entry_count "${section_json_file}" '.exempt | length'
      if [[ ! "${entry_count}" =~ ^[0-9]+$ ]]; then
        toolbelt::die "unexpected exempt length '${entry_count}'"
      fi
      for ((index = 0; index < entry_count; index++)); do
        count=0
        validate_entry "${section_json_file}" "${index}" "${scratch_file}" || count=$?
        errors=$((errors + count))
        step="$(< "${scratch_file}")" || toolbelt::die "cannot read ${scratch_file}"
        if [[ -z "${step}" ]]; then
          continue
        fi
        if [[ -n "${seen_steps["${step}"]+set}" ]]; then
          section_error "exempt[${index}]: duplicate step '${step}'"
          errors=$((errors + 1))
          continue
        fi
        seen_steps["${step}"]=1
        printf '%s\n' "${step}" >> "${out_exempt_file}" || toolbelt::die "cannot write ${out_exempt_file}"
      done
    else
      section_error 'exempt must be a list'
      errors=$((errors + 1))
    fi
  fi

  toolbelt::return_count "${errors}"
}

# @description Run yq on a scanned file with its stdout in out_file and its
#              stderr in YQ_ERR_FILE. Unlike toolbelt::yq it does not die:
#              a file yq cannot read is a violation for the caller to report,
#              not a crash. Merge keys resolve to the YAML spec, where a local
#              key beats a merged one, rather than yq's default, where the
#              merged key wins and a wrapped run body could stand in for the
#              one that actually runs.
# @global YQ_ERR_FILE file that receives yq's stderr
# @arg $1 out_file where to write yq's stdout
# @arg $2 expr the yq expression
# @arg $3 file the file to read
# @exitcode 0 yq succeeded
# @exitcode 1 yq failed
function scan_yq() {
  local -r out_file="$1"
  local -r expr="$2"
  local -r file="$3"
  if ! yq --yaml-fix-merge-anchor-to-spec=true --input-format=yaml --output-format=yaml "${expr}" "${file}" \
    > "${out_file}" 2> "${YQ_ERR_FILE}"; then
    return 1
  fi
  toolbelt::require_file "${out_file}"
}

# @description Decode a base64 field of an extract_run_steps record into the
#              named variable. The value is kept up to the first NUL, trailing
#              newlines included; it is used for display, and for a step id
#              only when the record marks the id free of control characters.
# @global TMP_DIR the scratch directory
# @arg $1 result_var name of the variable to set
# @arg $2 encoded base64 text, possibly empty
function decode_field() {
  local -n decoded_ref="$1"
  local -r encoded="$2"
  local -r field_file="${TMP_DIR}/field"
  base64 --decode <<< "${encoded}" > "${field_file}" || toolbelt::die "cannot decode '${encoded}'"
  # read -d '' always reports end of input as status 1, so that status says
  # nothing.
  # shellcheck disable=SC2034 # set through the nameref; the caller reads it
  IFS= read -r -d '' decoded_ref < "${field_file}" || true
}

# @description Store a human-readable identifier for a step in the named
#              variable, used to report a step that has no YAML id to key an
#              exemption on. Job and name print escaped onto one line.
# @arg $1 result_var name of the variable to set
# @arg $2 job job key, or `runs` for a composite action
# @arg $3 index zero-based position of the step within its job
# @arg $4 name the step's `name:`, possibly empty
function step_label() {
  local -n label_ref="$1"
  local -r job="$2"
  local -r index="$3"
  local -r name="$4"
  local shown_job shown_index shown_name
  toolbelt::printable shown_job "${job}"
  toolbelt::printable shown_index "${index}"
  if [[ -z "${name}" ]]; then
    label_ref="job '${shown_job}' step #${shown_index}"
  else
    toolbelt::printable shown_name "${name}"
    # shellcheck disable=SC2034 # set through the nameref; the caller reads it
    label_ref="job '${shown_job}' step #${shown_index} (${shown_name})"
  fi
}

# @description Store in the named variable how many lines of a file equal the
#              given text exactly. A grep error dies rather than reading as
#              zero, which would turn a stale-exemption check into a silent
#              pass.
# @global TMP_DIR the scratch directory
# @arg $1 result_var name of the variable to set
# @arg $2 file the file to search
# @arg $3 line the exact line to count
function count_lines() {
  local -n count_ref="$1"
  local -r file="$2"
  local -r line="$3"
  local -r count_file="${TMP_DIR}/line-count"
  local status=0
  grep --count --fixed-strings --line-regexp -- "${line}" "${file}" > "${count_file}" || status=$?
  if ((status > 1)); then
    toolbelt::die "cannot search ${file}"
  fi
  local counted
  counted="$(< "${count_file}")" || toolbelt::die "cannot read ${count_file}"
  if [[ ! "${counted}" =~ ^[0-9]+$ ]]; then
    toolbelt::die "unexpected line count '${counted}' for ${file}"
  fi
  # shellcheck disable=SC2034 # set through the nameref; the caller reads it
  count_ref="${counted}"
}

# @description Write the repo-relative path of every `*.yml` and `*.yaml` file
#              under the scan roots to out_file, NUL-separated and sorted. A
#              missing root is skipped. A root that exists but is not a
#              directory, a dangling link included, is a violation rather than
#              "no files", and a root find cannot fully list dies. Symlinks are
#              followed, so a linked file or action directory is scanned, and
#              a dangling link below a root is listed for yq to reject.
# @global TMP_DIR the scratch directory
# @global REPO_ROOT the repo root
# @arg $1 out_file where to write the paths
# @arg $2 total_var name of the violation counter to increase
# @stdout `<root>: not a directory` per root that is not one
function list_scan_files() {
  local -r out_file="$1"
  local -n list_total_ref="$2"
  local -r unsorted_file="${TMP_DIR}/files-unsorted"
  local -r find_err_file="${TMP_DIR}/find-stderr"
  : > "${unsorted_file}" || toolbelt::die "cannot write ${unsorted_file}"
  local root abs_root
  for root in "${SCAN_ROOTS[@]}"; do
    abs_root="${REPO_ROOT}/${root}"
    if [[ ! -e "${abs_root}" && ! -L "${abs_root}" ]]; then
      continue
    fi
    if [[ ! -d "${abs_root}" ]]; then
      printf '%s: not a directory\n' "${root}"
      list_total_ref=$((list_total_ref + 1))
      continue
    fi
    if ! find -L "${abs_root}" \( -type f -o -type l \) \( -name '*.yml' -o -name '*.yaml' \) \
      -printf "${root}/%P\\0" >> "${unsorted_file}" 2> "${find_err_file}"; then
      toolbelt::die "cannot list ${root}: $(< "${find_err_file}")"
    fi
  done
  sort --zero-terminated --output="${out_file}" -- "${unsorted_file}" || toolbelt::die "cannot sort ${unsorted_file}"
}

# @description Check one scanned file against both rules, reporting each
#              violation and recording each keyed run step in seen_file as
#              `<key>|<1 if compliant, else 0>`.
# @global REPO_ROOT the repo root
# @global TMP_DIR the scratch directory
# @global YQ_ERR_FILE file that receives yq's stderr
# @arg $1 rel the file's repo-relative path
# @arg $2 wrapper the wrapper a compliant run body names
# @arg $3 seen_file where to append the keyed run steps
# @arg $4 total_var name of the violation counter to increase
# @stdout one line per violation
function scan_file() {
  local -r rel="$1"
  local -r wrapper="$2"
  local -r seen_file="$3"
  local -n total_ref="$4"
  local -r file="${REPO_ROOT}/${rel}"
  local -r out_file="${TMP_DIR}/scan-out"
  local -r steps_file="${TMP_DIR}/steps"
  local shown_rel shown_wrapper
  toolbelt::printable shown_rel "${rel}"
  toolbelt::printable shown_wrapper "${wrapper}"

  # Rule 2 on the raw text catches the spelling in a comment, which no YAML
  # read sees. grep fails on a file it cannot read, which yq then reports as
  # not valid YAML; one that yq reads but grep cannot dies below.
  local grep_status=0 direct=0
  grep --extended-regexp --quiet -- "${FORBIDDEN_PATTERN}" "${file}" 2> '/dev/null' || grep_status=$?
  if ((grep_status == 0)); then
    direct=1
  fi

  if ! TOOLBELT_FORBIDDEN_PATTERN="${FORBIDDEN_PATTERN}" \
    scan_yq "${out_file}" "${DIRECT_SCALARS_EXPR}" "${file}"; then
    if ((direct == 1)); then
      printf '%s: spells "%s"; only %s may enter the devShell\n' "${shown_rel}" "${FORBIDDEN_SPELLING}" \
        "${shown_wrapper}"
      total_ref=$((total_ref + 1))
    fi
    printf '%s: not valid YAML\n' "${shown_rel}"
    total_ref=$((total_ref + 1))
    return 0
  fi
  if ((grep_status > 1)); then
    toolbelt::die "grep cannot read ${shown_rel}"
  fi
  local count
  while IFS= read -r count; do
    if [[ ! "${count}" =~ ^[0-9]+$ ]]; then
      toolbelt::die "unexpected scalar count '${count}' for ${shown_rel}"
    fi
    if ((count > 0)); then
      direct=1
    fi
  done < "${out_file}" # coverage-exempt: kcov scores this line; it never executes as bash
  if ((direct == 1)); then
    printf '%s: spells "%s"; only %s may enter the devShell\n' "${shown_rel}" "${FORBIDDEN_SPELLING}" \
      "${shown_wrapper}"
    total_ref=$((total_ref + 1))
  fi

  # The YAML spec requires unique keys, so a duplicate extends `not valid YAML`.
  if ! scan_yq "${out_file}" "${WORKFLOW_DUPLICATE_KEYS_EXPR}" "${file}"; then
    toolbelt::die "yq failed on ${shown_rel} after parsing it: $(< "${YQ_ERR_FILE}")"
  fi
  local line
  while IFS= read -r line; do
    printf '%s: not valid YAML: %s\n' "${shown_rel}" "${line}"
    total_ref=$((total_ref + 1))
  done < "${out_file}" # coverage-exempt: kcov scores this line; it never executes as bash

  # A non-core tag changes what a node means to each parser that reads it, so
  # the scan cannot vouch for what the runner will do with that file.
  if ! scan_yq "${out_file}" "${TOOLBELT_UNSUPPORTED_TAGS_EXPR}" "${file}"; then
    toolbelt::die "yq failed on ${shown_rel} after parsing it: $(< "${YQ_ERR_FILE}")"
  fi
  while IFS= read -r line; do
    printf '%s: %s\n' "${shown_rel}" "${line}"
    total_ref=$((total_ref + 1))
  done < "${out_file}" # coverage-exempt: kcov scores this line; it never executes as bash

  if ! TOOLBELT_WRAPPER="${wrapper}" scan_yq "${steps_file}" "${EXTRACT_RUN_STEPS_EXPR}" "${file}"; then
    toolbelt::die "yq failed on ${shown_rel} after parsing it: $(< "${YQ_ERR_FILE}")"
  fi

  # Two passes: whether a step is exempt depends on how many run steps in the
  # file share its key, since ids are unique only within a job and document.
  local job_b64 index_b64 id_b64 id_unsafe name_b64 compliant extra
  local job index id name key label shown_id
  local -a record_keys=()
  local -A key_counts=()
  while IFS='|' read -r job_b64 index_b64 id_b64 id_unsafe name_b64 compliant extra; do
    if [[ -n "${extra}" || ! "${id_unsafe}" =~ ^(true|false)$ || ! "${compliant}" =~ ^(true|false)$ ]]; then
      toolbelt::die "unexpected step record for ${shown_rel}"
    fi
    decode_field id "${id_b64}"
    key=''
    # A key holding a control character can match no exemption, and a newline
    # in it would forge extra lines in seen_file.
    if [[ -n "${id}" && "${id_unsafe}" == 'false' && "${rel}" != *[[:cntrl:]]* ]]; then
      key="${rel}::${id}"
      key_counts["${key}"]=$((${key_counts["${key}"]:-0} + 1))
      if [[ "${compliant}" == 'true' ]]; then
        printf '%s|1\n' "${key}" >> "${seen_file}" || toolbelt::die "cannot write ${seen_file}"
      else
        printf '%s|0\n' "${key}" >> "${seen_file}" || toolbelt::die "cannot write ${seen_file}"
      fi
    fi
    record_keys+=("${key}")
  done < "${steps_file}" # coverage-exempt: kcov scores this line; it never executes as bash

  local record_index=0
  while IFS='|' read -r job_b64 index_b64 id_b64 id_unsafe name_b64 compliant extra; do
    key="${record_keys[record_index]}"
    record_index=$((record_index + 1))
    if [[ "${compliant}" == 'true' ]]; then
      continue
    fi
    # An exemption shared by several steps covers none of them; report_stale
    # reports it as ambiguous.
    if [[ -n "${key}" && -n "${EXEMPT_STEPS["${key}"]+set}" && "${key_counts["${key}"]}" == '1' ]]; then
      continue
    fi
    decode_field id "${id_b64}"
    if [[ -z "${id}" && "${id_unsafe}" == 'false' ]]; then
      decode_field job "${job_b64}"
      decode_field index "${index_b64}"
      decode_field name "${name_b64}"
      step_label label "${job}" "${index}" "${name}"
      printf '%s: %s does not invoke %s and has no YAML id:; add one (%s exemptions are keyed <file>::<id>)\n' \
        "${shown_rel}" "${label}" "${shown_wrapper}" "${TOOLBELT_CONFIG}"
    else
      toolbelt::printable shown_id "${id}"
      printf '%s::%s: run step does not invoke %s\n' "${shown_rel}" "${shown_id}" "${shown_wrapper}"
    fi
    total_ref=$((total_ref + 1))
  done < "${steps_file}" # coverage-exempt: kcov scores this line; it never executes as bash
}

# @description Report every exemption that does not cover exactly one
#              non-compliant run step. It is stale when it names no run step,
#              or names only steps that already use the wrapper, however many.
#              It is ambiguous when it names a non-compliant step and at least
#              one other run step: ids are unique only within a job and
#              document, and one exemption silently covering several steps
#              would let a new step inherit an old reason.
# @arg $1 exempt_file the exempt steps, one per line
# @arg $2 seen_file the keyed run steps, as written by scan_file
# @arg $3 wrapper the wrapper a compliant run body names
# @arg $4 total_var name of the violation counter to increase
# @stdout one line per stale or ambiguous exemption
function report_stale() {
  local -r exempt_file="$1"
  local -r seen_file="$2"
  local -r wrapper="$3"
  local -n stale_total_ref="$4"
  local shown_wrapper
  toolbelt::printable shown_wrapper "${wrapper}"
  toolbelt::require_file "${exempt_file}"
  local entry unwrapped wrapped
  while IFS= read -r entry; do
    count_lines unwrapped "${seen_file}" "${entry}|0"
    count_lines wrapped "${seen_file}" "${entry}|1"
    if ((unwrapped == 0 && wrapped == 0)); then
      printf 'stale exemption in %s: %s matches no run step\n' "${TOOLBELT_CONFIG}" "${entry}"
    elif ((unwrapped == 0)); then
      printf 'stale exemption in %s: %s already invokes %s\n' "${TOOLBELT_CONFIG}" "${entry}" \
        "${shown_wrapper}"
    elif ((unwrapped + wrapped > 1)); then
      printf 'ambiguous exemption in %s: %s matches %d run steps; give each step a unique id\n' \
        "${TOOLBELT_CONFIG}" "${entry}" "$((unwrapped + wrapped))"
    else
      continue
    fi
    stale_total_ref=$((stale_total_ref + 1))
  done < "${exempt_file}" # coverage-exempt: kcov scores this line; it never executes as bash
}

# @description Validate the section, then scan every workflow and action file.
# @global SECTION_FILE the section JSON the runner wrote
# @global TMP_DIR the run's scratch directory
# @global EXEMPT_STEPS filled with the exempt step keys
# @noargs
function main() {
  local -r exempt_file="${TMP_DIR}/exempt"
  local -r files_file="${TMP_DIR}/files"
  local -r seen_file="${TMP_DIR}/seen"
  local errors=0 count=0
  local wrapper=''

  validate_section "${SECTION_FILE}" "${exempt_file}" wrapper || count=$?
  errors=$((errors + count))

  if ((errors > 0)); then
    printf '%s %s error(s)\n' "${errors}" "${TOOLBELT_CONFIG}"
    exit 1
  fi

  toolbelt::require_file "${exempt_file}"
  local entry
  while IFS= read -r entry; do
    EXEMPT_STEPS["${entry}"]=1
  done < "${exempt_file}" # coverage-exempt: kcov scores this line; it never executes as bash

  : > "${seen_file}" || toolbelt::die "cannot write ${seen_file}"
  local total=0 rel
  list_scan_files "${files_file}" total
  while IFS= read -r -d '' rel; do
    scan_file "${rel}" "${wrapper}" "${seen_file}" total
  done < "${files_file}" # coverage-exempt: kcov scores this line; it never executes as bash

  report_stale "${exempt_file}" "${seen_file}" "${wrapper}" total

  if ((total > 0)); then
    printf '%d hermetic-boundary violation(s)\n' "${total}"
    exit 1
  fi
}

case "$#" in
  0) ;; # coverage-exempt: kcov scores this line; it never executes as bash
  1)
    case "$1" in
      --help)
        printf '%s\n' "${USAGE}"
        exit 0
        ;;
      *) toolbelt::die "unexpected argument '$1'; ${USAGE}" ;;
    esac
    ;;
  *) toolbelt::die "expected at most one argument, got $#; ${USAGE}" ;;
esac

# The die inside runs in the substitution's subshell, so its status is tested.
if ! REPO_ROOT="$(toolbelt::repo_root)"; then
  exit "${TOOLBELT_SETUP_FAILURE}"
fi
readonly REPO_ROOT

if [[ -z "${TOOLBELT_SECTION:-}" ]]; then
  toolbelt::die 'TOOLBELT_SECTION is not set'
fi
if [[ ! -f "${TOOLBELT_SECTION}" ]]; then
  toolbelt::die "TOOLBELT_SECTION names no file: ${TOOLBELT_SECTION}"
fi
readonly SECTION_FILE="${TOOLBELT_SECTION}"

# One scratch directory per run, holding every temp file and removed on any
# exit. Script-level, not local: the single-quoted EXIT trap expands it at
# exit, after any function's locals are gone.
TMP_DIR="$(mktemp --directory)"
readonly TMP_DIR
trap 'rm --recursive --force -- "${TMP_DIR}"' EXIT
readonly QUERY_FILE="${TMP_DIR}/query"
readonly YQ_ERR_FILE="${TMP_DIR}/yq-stderr"

main "$@"
